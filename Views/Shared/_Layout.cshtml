@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Trường Đại học Công nghiệp Việt - Hung" : "Trường Đại học Công nghiệp Việt - Hung (VIU)")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Cổng thông tin điện tử chính thức của Trường Đại học Công nghiệp Việt - Hung (VIU) - Bộ Công Thương")" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- 1. TOP UTILITY BAR -->
    <div class="viu-topbar">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-none d-md-flex align-items-center gap-3">
                <span><i class="fa-solid fa-phone me-1 text-warning"></i>Hotline Tuyển sinh: <strong>024.3383.8345</strong></span>
                <span class="viu-topbar-divider"></span>
                <span><i class="fa-solid fa-envelope me-1 text-warning"></i>tuyensinh@viu.edu.vn</span>
                <span class="viu-topbar-divider"></span>
                <span><i class="fa-solid fa-building-columns me-1 text-warning"></i>Trực thuộc Bộ Công Thương</span>
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <a href="/sinh-vien" class="text-decoration-none"><i class="fa-solid fa-user-graduate me-1 text-warning"></i>Cổng Sinh viên</a>
                <span class="viu-topbar-divider"></span>
                <a href="/dao-tao/giang-vien" class="text-decoration-none"><i class="fa-solid fa-chalkboard-user me-1 text-warning"></i>Giảng viên</a>
                <span class="viu-topbar-divider"></span>
                <button type="button" class="btn btn-link p-0 text-white text-decoration-none" data-bs-toggle="modal" data-bs-target="#globalSearchModal">
                    <i class="fa-solid fa-magnifying-glass me-1 text-warning"></i>Tìm kiếm
                </button>
                <span class="viu-topbar-divider"></span>
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="text-warning"><i class="fa-solid fa-user-shield me-1"></i>@User.Identity!.Name</span>
                    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                    {
                        <a href="/Admin/Dashboard" class="badge bg-warning text-dark text-decoration-none fw-bold">Trang Quản trị</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link btn-sm text-white-50 p-0 text-decoration-none ms-1">Thoát</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none"><i class="fa-solid fa-right-to-bracket me-1 text-warning"></i>Đăng nhập</a>
                }
            </div>
        </div>
    </div>

    <!-- 2. STICKY HEADER & MEGA NAVIGATION -->
    <header class="viu-header sticky-top">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <!-- Brand Logo -->
            <a class="viu-brand d-flex align-items-center gap-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                <div class="viu-logo-mark">VIU</div>
                <div>
                    <div class="fw-bold viu-brand-name">TRƯỜNG ĐẠI HỌC CÔNG NGHIỆP VIỆT - HUNG</div>
                    <div class="small text-muted" style="font-size: 12px; letter-spacing: 0.2px;">VIETNAM - HUNGARY INDUSTRIAL UNIVERSITY (MÃ TRƯỜNG: VHD)</div>
                </div>
            </a>

            <!-- Mobile toggle -->
            <button class="navbar-toggler d-lg-none border-0 text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#viuNav">
                <i class="fa-solid fa-bars fa-xl"></i>
            </button>

            <!-- Navbar Links -->
            <nav class="collapse navbar-collapse justify-content-end" id="viuNav">
                <ul class="navbar-nav viu-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    
                    <!-- Giới thiệu Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Giới thiệu
                        </a>
                        <ul class="dropdown-menu dropdown-menu-viu">
                            <li><a class="dropdown-item" href="/gioi-thieu"><i class="fa-solid fa-circle-info text-warning me-2"></i>Tổng quan & Lịch sử 1977</a></li>
                            <li><a class="dropdown-item" href="/gioi-thieu#co-so"><i class="fa-solid fa-map-location-dot text-warning me-2"></i>Hệ thống 3 Cơ sở đào tạo</a></li>
                            <li><a class="dropdown-item" href="/hop-tac"><i class="fa-solid fa-handshake text-warning me-2"></i>Quan hệ Việt Nam - Hungary</a></li>
                            <li><a class="dropdown-item" href="/lien-he"><i class="fa-solid fa-address-book text-warning me-2"></i>Thông tin liên hệ & Chỉ đường</a></li>
                        </ul>
                    </li>

                    <!-- Đào tạo Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Đào tạo
                        </a>
                        <ul class="dropdown-menu dropdown-menu-viu">
                            <li><a class="dropdown-item" href="/dao-tao"><i class="fa-solid fa-graduation-cap text-warning me-2"></i>Tổng quan Đào tạo & Các Khoa</a></li>
                            <li><a class="dropdown-item" href="/dao-tao/nganh/cong-nghe-thong-tin"><i class="fa-solid fa-laptop-code text-warning me-2"></i>Ngành Công nghệ thông tin</a></li>
                            <li><a class="dropdown-item" href="/dao-tao/nganh/ky-thuat-phan-mem"><i class="fa-solid fa-code text-warning me-2"></i>Ngành Kỹ thuật phần mềm</a></li>
                            <li><a class="dropdown-item" href="/dao-tao/nganh/cong-nghe-ky-thuat-dien-dien-tu"><i class="fa-solid fa-bolt text-warning me-2"></i>Ngành Điện - Điện tử</a></li>
                            <li><a class="dropdown-item" href="/dao-tao/nganh/quan-tri-kinh-doanh"><i class="fa-solid fa-chart-pie text-warning me-2"></i>Ngành Quản trị kinh doanh</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/dao-tao/giang-vien"><i class="fa-solid fa-users text-warning me-2"></i>Đội ngũ Cán bộ & Giảng viên</a></li>
                        </ul>
                    </li>

                    <!-- Tuyển sinh Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Tuyển sinh 2026
                        </a>
                        <ul class="dropdown-menu dropdown-menu-viu">
                            <li><a class="dropdown-item" href="/tuyen-sinh"><i class="fa-solid fa-bullhorn text-warning me-2"></i>Đề án Tuyển sinh Đại học 2026</a></li>
                            <li><a class="dropdown-item" href="/tuyen-sinh/tra-cuu-diem-chuan"><i class="fa-solid fa-chart-column text-warning me-2"></i>Tra cứu điểm chuẩn các năm</a></li>
                            <li><a class="dropdown-item" href="/tuyen-sinh/tinh-diem"><i class="fa-solid fa-wand-magic-sparkles text-warning me-2"></i><strong>Công cụ tính điểm & Chọn ngành</strong></a></li>
                            <li><a class="dropdown-item" href="/tuyen-sinh#form-dang-ky"><i class="fa-solid fa-file-signature text-warning me-2"></i>Đăng ký xét tuyển trực tuyến</a></li>
                        </ul>
                    </li>

                    <!-- Nghiên cứu & Hợp tác -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Nghiên cứu & Đối tác
                        </a>
                        <ul class="dropdown-menu dropdown-menu-viu">
                            <li><a class="dropdown-item" href="/nghien-cuu"><i class="fa-solid fa-atom text-warning me-2"></i>Nghiên cứu khoa học & Chuyển giao</a></li>
                            <li><a class="dropdown-item" href="/hop-tac"><i class="fa-solid fa-earth-americas text-warning me-2"></i>Hợp tác quốc tế & Học bổng Hungary</a></li>
                            <li><a class="dropdown-item" href="/hop-tac#doanh-nghiep"><i class="fa-solid fa-briefcase text-warning me-2"></i>Mạng lưới Doanh nghiệp tuyển dụng</a></li>
                        </ul>
                    </li>

                    <!-- Tin tức & Thông báo -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Tin tức & Sự kiện
                        </a>
                        <ul class="dropdown-menu dropdown-menu-viu">
                            <li><a class="dropdown-item" asp-controller="News" asp-action="Index"><i class="fa-solid fa-newspaper text-warning me-2"></i>Tin tức nhà trường</a></li>
                            <li><a class="dropdown-item" asp-controller="Announcements" asp-action="Index"><i class="fa-solid fa-bell text-warning me-2"></i>Thông báo chính thức</a></li>
                            <li><a class="dropdown-item" asp-controller="Events" asp-action="Index"><i class="fa-regular fa-calendar-check text-warning me-2"></i>Lịch sự kiện sắp tới</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/lien-he">Liên hệ</a>
                    </li>

                    <!-- Nút CTA Tuyển sinh -->
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <a href="/tuyen-sinh#form-dang-ky" class="btn btn-cta-admission">
                            <i class="fa-solid fa-paper-plane me-1"></i> ĐĂNG KÝ XÉT TUYỂN
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Global Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- MAIN BODY -->
    <main>
        @RenderBody()
    </main>

    <!-- 3. FOOTER -->
    <footer class="viu-footer">
        <div class="container py-5">
            <div class="row g-4">
                <!-- Cột 1: Thông tin trường -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="viu-logo-mark viu-logo-mark--light">VIU</div>
                        <div>
                            <div class="fw-bold text-white fs-5">ĐẠI HỌC CÔNG NGHIỆP VIỆT - HUNG</div>
                            <div class="small text-white-50">Cơ sở giáo dục đại học công lập - Bộ Công Thương</div>
                        </div>
                    </div>
                    <p class="text-white-75 small leading-relaxed mb-4">
                        Tiền thân thành lập năm 1977. Nơi đào tạo nguồn nhân lực chất lượng cao trong các lĩnh vực công nghệ thông tin, kỹ thuật tự động hóa, điện tử và quản trị kinh doanh.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" target="_blank" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="https://youtube.com" target="_blank" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="fa-brands fa-youtube"></i></a>
                        <a href="https://tiktok.com" target="_blank" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="https://zalo.me" target="_blank" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="fa-solid fa-comment-dots"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Liên kết nhanh -->
                <div class="col-lg-2 col-6">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 0.5px;">Khám phá VIU</h6>
                    <ul class="list-unstyled viu-footer-links">
                        <li><a href="/gioi-thieu"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Giới thiệu trường</a></li>
                        <li><a href="/dao-tao"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Ngành đào tạo</a></li>
                        <li><a href="/tuyen-sinh"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Tuyển sinh 2026</a></li>
                        <li><a href="/tuyen-sinh/tinh-diem"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Tính điểm xét tuyển</a></li>
                        <li><a href="/nghien-cuu"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Nghiên cứu khoa học</a></li>
                        <li><a href="/hop-tac"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Hợp tác quốc tế</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Tiện ích & Hỗ trợ -->
                <div class="col-lg-2 col-6">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 0.5px;">Tiện ích sinh viên</h6>
                    <ul class="list-unstyled viu-footer-links">
                        <li><a href="/sinh-vien"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Cổng sinh viên</a></li>
                        <li><a href="/dao-tao/giang-vien"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Danh bạ giảng viên</a></li>
                        <li><a asp-controller="News" asp-action="Index"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Tin tức sự kiện</a></li>
                        <li><a asp-controller="Announcements" asp-action="Index"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Bảng thông báo</a></li>
                        <li><a href="/lien-he"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Liên hệ & Góp ý</a></li>
                        <li><a href="/Account/Login"><i class="fa-solid fa-angle-right me-1 text-warning"></i>Đăng nhập hệ thống</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Hệ thống 3 cơ sở đào tạo -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 0.5px;">Hệ thống 3 Cơ sở đào tạo</h6>
                    <div class="viu-footer-campus-box">
                        <div class="fw-semibold text-warning small"><i class="fa-solid fa-location-dot me-1"></i>Cơ sở 1 (Tùng Thiện - Trụ sở chính):</div>
                        <div class="text-white-75 small">Số 16 phố Hữu Nghị, P. Xuân Khanh, TX. Sơn Tây, Hà Nội</div>
                    </div>
                    <div class="viu-footer-campus-box">
                        <div class="fw-semibold text-warning small"><i class="fa-solid fa-location-dot me-1"></i>Cơ sở 2 (Tây Phương):</div>
                        <div class="text-white-75 small">Xã Thạch Hòa, H. Thạch Thất, Hà Nội (Gần Khu CNC Hòa Lạc)</div>
                    </div>
                    <div class="viu-footer-campus-box">
                        <div class="fw-semibold text-warning small"><i class="fa-solid fa-location-dot me-1"></i>Cơ sở 3 (Thanh Xuân):</div>
                        <div class="text-white-75 small">Khuất Duy Tiến, Q. Thanh Xuân, Hà Nội</div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-4" />
            <div class="row align-items-center">
                <div class="col-md-8 text-center text-md-start">
                    <p class="text-white-50 small mb-0">
                        &copy; @DateTime.Now.Year Trường Đại học Công nghiệp Việt - Hung (VIU). Giữ toàn quyền.
                    </p>
                </div>
                <div class="col-md-4 text-center text-md-end mt-2 mt-md-0">
                    <span class="badge bg-warning text-dark fw-bold">MÃ TRƯỜNG: VHD</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- 4. GLOBAL SEARCH MODAL -->
    <div class="modal fade" id="globalSearchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom p-3">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass text-warning"></i></span>
                        <input type="text" id="globalSearchInput" class="form-control border-0 shadow-none ps-0" placeholder="Tìm kiếm ngành học, tin tức, thông báo (ví dụ: CNTT, học bổng, điểm chuẩn...)" autofocus />
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4" style="max-height: 480px; overflow-y: auto;">
                    <div id="searchPlaceholder" class="text-center py-4 text-muted">
                        <i class="fa-solid fa-magnifying-glass fa-2x mb-2 text-warning"></i>
                        <p class="mb-0">Nhập từ khóa để tìm kiếm thông tin trên toàn hệ thống Cổng VIU.</p>
                    </div>
                    <div id="searchResultsContainer" style="display: none;">
                        <!-- Results injected via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. FLOATING AI ADMISSION ASSISTANT WIDGET -->
    <div class="viu-ai-widget">
        <div class="viu-ai-btn" id="viuAiToggleBtn" title="Hỏi đáp Tuyển sinh VIU">
            <i class="fa-solid fa-headset"></i>
            <div class="viu-ai-badge"></div>
        </div>

        <div class="viu-ai-window" id="viuAiChatWindow">
            <div class="viu-ai-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-1 rounded-circle bg-warning text-dark"><i class="fa-solid fa-robot"></i></div>
                    <div>
                        <div class="fw-bold small">Trợ lý Tuyển sinh VIU 2026</div>
                        <div class="text-white-50" style="font-size: 11px;">Trực tuyến 24/7</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" id="viuAiCloseBtn"></button>
            </div>
            <div class="viu-ai-body" id="viuAiChatMessages">
                <div class="p-3 rounded-4 bg-light small mb-3 border">
                    Xin chào! Tôi là Trợ lý tư vấn tuyển sinh VIU. Bạn đang quan tâm đến thông tin nào dưới đây?
                </div>
                <div class="d-flex flex-column gap-1 mb-3">
                    <button class="viu-ai-faq-btn" onclick="askAiFaq(1)">🎯 Điểm chuẩn các ngành năm 2025?</button>
                    <button class="viu-ai-faq-btn" onclick="askAiFaq(2)">💰 Học phí các ngành khoảng bao nhiêu?</button>
                    <button class="viu-ai-faq-btn" onclick="askAiFaq(3)">📝 Các phương thức xét tuyển 2026?</button>
                    <button class="viu-ai-faq-btn" onclick="askAiFaq(4)">🏢 Ký túc xá và học bổng cho tân sinh viên?</button>
                    <button class="viu-ai-faq-btn" onclick="askAiFaq(5)">📞 Hotline và địa chỉ nhận hồ sơ?</button>
                </div>
                <div id="aiDynamicReply"></div>
            </div>
            <div class="p-2 bg-light border-top text-center">
                <a href="/tuyen-sinh#form-dang-ky" class="btn btn-warning text-dark btn-sm rounded-pill fw-bold w-100">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Đăng ký xét tuyển trực tuyến ngay
                </a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global search and AI Chatbot script -->
    <script>
        // Global search live AJAX
        const searchInput = document.getElementById('globalSearchInput');
        const searchContainer = document.getElementById('searchResultsContainer');
        const searchPlaceholder = document.getElementById('searchPlaceholder');
        let searchTimeout = null;

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                const query = this.value.trim();
                if (query.length < 2) {
                    searchPlaceholder.style.display = 'block';
                    searchContainer.style.display = 'none';
                    return;
                }

                searchTimeout = setTimeout(() => {
                    fetch('/api/search?q=' + encodeURIComponent(query))
                        .then(r => r.json())
                        .then(data => {
                            searchPlaceholder.style.display = 'none';
                            searchContainer.style.display = 'block';
                            searchContainer.innerHTML = '';

                            const allResults = [];
                            if (data.majors) data.majors.forEach(m => allResults.push(m));
                            if (data.news) data.news.forEach(n => allResults.push(n));
                            if (data.announcements) data.announcements.forEach(a => allResults.push(a));

                            if (allResults.length === 0) {
                                searchContainer.innerHTML = '<div class="text-center py-4 text-muted"><p>Không tìm thấy kết quả phù hợp với từ khóa "' + query + '".</p></div>';
                                return;
                            }

                            allResults.forEach(item => {
                                const el = document.createElement('a');
                                el.href = item.url;
                                el.className = 'search-modal-result-item';
                                el.innerHTML = `
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge ${item.type === 'Ngành học' ? 'bg-warning text-dark' : (item.type === 'Tin tức' ? 'bg-primary' : 'bg-danger')} me-2" style="font-size:11px;">${item.type}</span>
                                            <strong class="text-dark">${item.title}</strong>
                                        </div>
                                        <small class="text-muted">${item.date}</small>
                                    </div>
                                `;
                                searchContainer.appendChild(el);
                            });
                        });
                }, 300);
            });
        }

        // AI Chatbot Widget toggle
        const aiToggleBtn = document.getElementById('viuAiToggleBtn');
        const aiChatWindow = document.getElementById('viuAiChatWindow');
        const aiCloseBtn = document.getElementById('viuAiCloseBtn');

        if (aiToggleBtn && aiChatWindow) {
            aiToggleBtn.addEventListener('click', () => {
                aiChatWindow.style.display = (aiChatWindow.style.display === 'block') ? 'none' : 'block';
            });
        }
        if (aiCloseBtn && aiChatWindow) {
            aiCloseBtn.addEventListener('click', () => {
                aiChatWindow.style.display = 'none';
            });
        }

        function askAiFaq(id) {
            const replyContainer = document.getElementById('aiDynamicReply');
            let content = '';

            switch(id) {
                case 1:
                    content = '<strong>Điểm chuẩn năm 2025:</strong> Dao động từ 18.5 đến 21.0 điểm. Trong đó CNTT: 21.0 điểm; Kỹ thuật phần mềm: 20.5 điểm; Điện - Điện tử: 19.0 điểm; Quản trị kinh doanh: 19.5 điểm. <a href="/tuyen-sinh/tra-cuu-diem-chuan" class="text-primary fw-bold">Xem bảng điểm chuẩn chi tiết</a>.';
                    break;
                case 2:
                    content = '<strong>Học phí:</strong> Là trường công lập trực thuộc Bộ Công Thương, học phí tại VIU rất ưu đãi: khối kỹ thuật công nghệ từ 14 - 15 triệu đ/năm, khối kinh tế từ 13 triệu đ/năm. Có học bổng khuyến học lên đến 100% học phí!';
                    break;
                case 3:
                    content = '<strong>Phương thức xét tuyển 2026:</strong> Gồm 4 phương thức: (1) Xét điểm thi tốt nghiệp THPT, (2) Xét học bạ THPT (từ 18.0 điểm), (3) Xét tuyển thẳng học sinh giỏi, (4) Xét kết hợp chứng chỉ IELTS từ 5.0 trở lên. <a href="/tuyen-sinh/tinh-diem" class="text-primary fw-bold">Thử tính điểm xét tuyển</a>.';
                    break;
                case 4:
                    content = '<strong>Ký túc xá & Học bổng:</strong> Trường có KTX hơn 2.000 chỗ khang trang, đầy đủ tiện nghi với mức phí chỉ từ 250k - 450k/tháng. Hàng năm dành hơn 5 tỷ đồng trao học bổng cho tân sinh viên có điểm đầu vào cao.';
                    break;
                case 5:
                    content = '<strong>Hotline Tuyển sinh:</strong> 024.3383.8345 | 098.xxxx.xxx. Hồ sơ nộp trực tiếp hoặc gửi chuyển phát nhanh về: Ban Tuyển sinh - Trường ĐH Công nghiệp Việt - Hung, Số 16 Hữu Nghị, Xuân Khanh, Sơn Tây, Hà Nội.';
                    break;
            }

            replyContainer.innerHTML = `
                <div class="p-3 rounded-4 bg-warning bg-opacity-15 text-dark small border border-warning mb-2 animate__animated animate__fadeIn">
                    ${content}
                </div>
            `;
            replyContainer.scrollIntoView({ behavior: 'smooth' });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
