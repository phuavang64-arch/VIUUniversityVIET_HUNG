@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @{
        const string SiteName = "Trường Đại học Công nghiệp Việt - Hung";
        var pageTitle = ViewData["Title"] as string;
        var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
            ? "Trường Đại học Công nghiệp Việt - Hung (VIU)"
            : pageTitle + " - " + SiteName;
        var pageDescription = (ViewData["Description"] as string)
            ?? "Cổng thông tin điện tử chính thức của Trường Đại học Công nghiệp Việt - Hung (VIU) - Bộ Công Thương";
        var ogImage = ViewData["OgImage"] as string;

        // URL tuyệt đối cho canonical / og:url. Bắt buộc dựng tay từ Request vì
        // dùng thẻ <link> hay <meta> đều phải là URL đầy đủ.
        var absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var shareImage = string.IsNullOrWhiteSpace(ogImage)
            ? $"{Context.Request.Scheme}://{Context.Request.Host}/images/viu/viu-plaza.jpg"
            : (ogImage!.StartsWith("http") ? ogImage! : $"{Context.Request.Scheme}://{Context.Request.Host}{ogImage}");
    }
    <title>@fullTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@absoluteUrl" />
    @* Trang lỗi (404) không nên được lập chỉ mục: nó vốn đã bị gỡ khỏi kết quả
       tìm kiếm, nhưng liên kết cũ trỏ tới đây vẫn cần thuận cho crawler. *@
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, follow" />
    }
    <meta name="theme-color" content="#083970" />

    @* Thẻ Open Graph: quyết định thẻ xem trước khi chia sẻ lên Facebook/Zalo.
       Không có những thẻ này, mọi liên kết tuyển sinh được chia sẻ ra ngoài đều
       hiện chỉ có đường dẫn trần. *@
    <meta property="og:site_name" content="@SiteName" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@absoluteUrl" />
    <meta property="og:image" content="@shareImage" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="~/images/logo-viu.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Source Serif 4 cho tiêu đề (thiết kế để đọc màn hình, có đủ dấu tiếng Việt),
       Source Sans 3 cho phần giao diện. Cả hai đều có subset vietnam trên Google Fonts. *@
    @* Be Vietnam Pro — chính là font HaUI dùng, thiết kế riêng cho tiếng Việt nên đủ
       dấu và có sẵn trên Google Fonts. *@
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Schema.org: điều kiện để Google hiển thị kết quả giàu (rich result) cho trường.
   Dùng Dictionary + JsonSerializer thay vì anonymous type: khoá "@context" và "@type"
   bắt buộc phải viết dạng chuỗi, vì Razor sẽ đọc "@context" trong `new { @context = ... }`
   thành biểu thức C# và sinh ra mã không biên dịch được. *@
    @{
        var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var orgSchema = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "CollegeOrUniversity",
            ["name"] = SiteName,
            ["alternateName"] = "VIU",
            ["url"] = origin + "/",
            ["logo"] = origin + "/images/logo-viu.png",
            ["image"] = shareImage,
            ["description"] = pageDescription,
            ["parentOrganization"] = new Dictionary<string, object>
            {
                ["@type"] = "GovernmentOrganization",
                ["name"] = "Bộ Công Thương"
            },
            ["address"] = new Dictionary<string, object>
            {
                ["@type"] = "PostalAddress",
                ["streetAddress"] = "Số 16 Hữu Nghị, phường Tùng Thiện",
                ["addressLocality"] = "thị xã Sơn Tây",
                ["addressRegion"] = "Hà Nội",
                ["addressCountry"] = "VN"
            },
            ["telephone"] = "+84 24 3383 8345",
            ["email"] = "tuyensinh@viu.edu.vn"
        };
        // Serialize trước rồi mới in: nội dung <script> phải là JSON thuần, Razor sẽ
        // HTML-encode nếu in trực tiếp giá trị.
        var orgSchemaJson = System.Text.Json.JsonSerializer.Serialize(orgSchema);
    }
    <script type="application/ld+json">@orgSchemaJson</script>
    @await RenderSectionAsync("StructuredData", required: false)
</head>
<body>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    // Đánh dấu menu con để mở sẵn khi đang ở trong nhóm.
    var inDaoTao = currentController == "Academics";
    var inTinTuc = currentController == "News";
    var inThongBao = currentController == "Announcements";
    var inSuKien = currentController == "Events";

    // /nghien-cuu và /hop-tac là chuyên mục bài viết riêng nhưng vẫn thuộc nhóm
    // "Giới thiệu"; /hoc-phi thuộc nhóm "Tuyển sinh".
    var inGioiThieu = (currentController == "Home" &&
                       (currentAction == "About" || currentAction == "StudentLife")) ||
                      currentController == "Research" || currentController == "Cooperations";
    var inTuyenSinh = currentController == "Admissions" || currentController == "Tuition";
    var inLienHe = currentController == "Home" && currentAction == "Contact";

    // "Trang chủ" chỉ được sáng khi đang thật sự ở trang chủ. Trước đây mục này sáng
    // trên mọi action khác của HomeController, kể cả trang 404 và trang lỗi - tức là
    // trên một trang không hề có nội dung trang chủ nào cả.
    var onHomeIndex = currentController == "Home" && currentAction == "Index";
}

<!-- ===== Thanh tiện ích ===== -->
<div class="viu-utility">
    <div class="wrap viu-utility__inner">
        <div class="viu-utility__group">
            <span class="viu-utility__hotline">Hotline Tuyển sinh: <strong>024.3383.8345</strong></span>
            <span class="viu-utility__sep" aria-hidden="true">|</span>
            <span class="viu-utility__hotline">Trực thuộc Bộ Công Thương</span>
        </div>
        <div class="viu-utility__group viu-utility__group--secondary">
            <a href="/sinh-vien">Cổng Sinh viên</a>
            <span class="viu-utility__sep" aria-hidden="true">|</span>
            <a href="/hop-tac">Hợp tác</a>
            <span class="viu-utility__sep" aria-hidden="true">|</span>
            @if (SignInManager.IsSignedIn(User))
            {
                <span class="viu-utility__sep" aria-hidden="true">|</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                {
                    <a href="/Admin"><strong>Quản trị</strong></a>
                    <span class="viu-utility__sep" aria-hidden="true">|</span>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline viu-utility__login">
                    <button type="submit" class="viu-utility__btn">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            }
            else
            {
                @* class viu-utility__login: giữ lại nút này trên mobile, phần còn lại
                   của nhóm bị ẩn để tiết kiệm chiều ngang. *@
                <a class="viu-utility__login" asp-controller="Account" asp-action="Login">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                    <span>Đăng nhập</span>
                </a>
            }
        </div>
    </div>
</div>

<!--
    Header chia 2 hàng, đúng cách HaUI làm:
      hàng 1 — logo + ô tìm kiếm
      hàng 2 — menu chính, chiếm hết chiều rộng
    Menu không chen vào hàng logo nên không bao giờ bị bóp hay tràn chữ.
-->
<header class="viu-header">
    <div class="wrap viu-header__row viu-header__row--brand">
        <a class="viu-brand" asp-controller="Home" asp-action="Index">
            <span class="viu-brand__mark">
                <img src="~/images/logo-viu.png" alt="Logo Trường Đại học Công nghiệp Việt - Hung" asp-append-version="true" />
            </span>
            <span class="viu-brand__text">
                <span class="viu-brand__name">Trường Đại học Công nghiệp Việt - Hung</span>
                <span class="viu-brand__sub">Mã trường: VHD · Trực thuộc Bộ Công Thương</span>
            </span>
        </a>

        <div class="viu-header__tools">
            @* Ô tìm kiếm toàn site. script trong site-interactions.js (initSearch) gọi
               /api/search và hiển thị kết quả dạng dropdown. *@
            <div class="viu-search" id="globalSearch">
                <div class="viu-search__field">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <label class="visually-hidden" for="globalSearchInput">Tìm kiếm nội dung</label>
                    <input type="search" class="viu-search__input" id="globalSearchInput"
                           placeholder="Tìm kiếm…" autocomplete="off" />
                </div>
                <div class="viu-search__panel" id="searchResults" hidden>
                    <div id="searchHint" class="p-3 small text-muted">
                        Nhập từ khoá để tìm tin tức, thông báo, sự kiện và ngành đào tạo.
                    </div>
                    <div id="searchResultsList"></div>
                    <div class="p-2 border-top">
                        <a id="searchSeeAll" class="btn-viu btn-viu-outline btn-viu-sm btn-viu-block" href="/tim-kiem" hidden>
                            Xem tất cả kết quả
                        </a>
                    </div>
                </div>
            </div>

            <button class="viu-nav-toggle" type="button" id="viuNavToggle"
                    aria-controls="viuNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </div>

    <div class="viu-header__nav-row">
        <div class="wrap">
            <!--
                Không dùng class "collapse navbar-collapse" của Bootstrap ở đây.
                Class collapse giữ display:none vĩnh viễn trên desktop trừ khi có
                navbar-expand-lg, còn nút mở lại bị ẩn bằng d-lg-none -> menu biến mất
                hoàn toàn từ 992px trở lên. Việc mở/đóng do class .show điều khiển.
            -->
            <nav class="viu-nav-collapse" id="viuNav" aria-label="Điều hướng chính">
            <div class="viu-navbar">
                <a class="nav-link @(onHomeIndex ? "active" : "")"
                   asp-controller="Home" asp-action="Index">Trang chủ</a>

                <div class="nav-item viu-dropdown">
                    <button class="nav-link viu-dropdown__toggle @(inGioiThieu ? "active" : "")"
                            type="button" aria-expanded="false"
                            aria-haspopup="true" data-viu-dropdown="viuDdGioiThieu">
                        Giới thiệu <i class="fa-solid fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </button>
                    <ul class="viu-dropdown__menu" id="viuDdGioiThieu">
                        <li><a href="/gioi-thieu">Tổng quan và lịch sử nhà trường</a></li>
                        <li><a href="/nghien-cuu">Nghiên cứu khoa học</a></li>
                        <li><a href="/hop-tac">Hợp tác quốc tế và doanh nghiệp</a></li>
                        <li><a href="/sinh-vien">Đời sống sinh viên</a></li>
                    </ul>
                </div>

                <a class="nav-link @(inDaoTao ? "active" : "")" href="/dao-tao">Đào tạo</a>

                <div class="nav-item viu-dropdown">
                    <button class="nav-link viu-dropdown__toggle @(inTuyenSinh ? "active" : "")"
                            type="button" aria-expanded="false"
                            aria-haspopup="true" data-viu-dropdown="viuDdTuyenSinh">
                        Tuyển sinh <i class="fa-solid fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </button>
                    <ul class="viu-dropdown__menu" id="viuDdTuyenSinh">
                        <li><a href="/tuyen-sinh">Đề án tuyển sinh</a></li>
                        <li><a href="/tuyen-sinh/tra-cuu-diem-chuan">Tra cứu điểm chuẩn</a></li>
                        <li><a href="/tuyen-sinh/tinh-diem">Công cụ tính điểm và chọn ngành</a></li>
                        <li><a href="/hoc-phi">Học phí</a></li>
                        <li><a href="/tuyen-sinh#form-dang-ky">Đăng ký xét tuyển</a></li>
                    </ul>
                </div>

                <a class="nav-link @(inTinTuc ? "active" : "")" href="/tin-tuc">Tin tức</a>
                <a class="nav-link @(inThongBao ? "active" : "")" href="/thong-bao">Thông báo</a>
                <a class="nav-link @(inSuKien ? "active" : "")" href="/su-kien">Sự kiện</a>
                <a class="nav-link @(inLienHe ? "active" : "")" href="/lien-he">Liên hệ</a>
            </div>
            </nav>
        </div>
    </div>
</header>

<main id="main-content">
    @RenderBody()
</main>

<!-- ===== Footer ===== -->
<footer class="viu-footer">
    <div class="wrap">
        <div class="viu-footer__grid">
            <div>
                <div class="viu-footer__brand">
                    <img src="~/images/logo-viu.png" alt="Logo Trường Đại học Công nghiệp Việt - Hung"
                         class="viu-footer__logo" asp-append-version="true" />
                    <span class="viu-footer__brand-name">Trường Đại học<br />Công nghiệp Việt - Hung</span>
                </div>
                <p class="viu-footer__about">
                    Cổng thông tin điện tử chính thức. Trường Đại học Công nghiệp Việt - Hung
                    trực thuộc Bộ Công Thương, mã trường VHD.
                </p>
            </div>

            <div>
                <h4>Đào tạo</h4>
                <ul class="viu-footer__list">
                    <li><a href="/dao-tao">Tổng quan đào tạo</a></li>
                    <li><a href="/dao-tao/khoa/khoa-cong-nghe-thong-tin">Khoa Công nghệ thông tin</a></li>
                    <li><a href="/dao-tao/khoa/khoa-dien-dien-tu">Khoa Điện - Điện tử</a></li>
                    <li><a href="/dao-tao/khoa/khoa-kinh-te">Khoa Kinh tế</a></li>
                    <li><a href="/dao-tao/giang-vien">Đội ngũ giảng viên</a></li>
                </ul>
            </div>

            <div>
                <h4>Tuyển sinh</h4>
                <ul class="viu-footer__list">
                    <li><a href="/tuyen-sinh">Đề án tuyển sinh</a></li>
                    <li><a href="/tuyen-sinh/tra-cuu-diem-chuan">Điểm chuẩn các năm</a></li>
                    <li><a href="/tuyen-sinh/tinh-diem">Tính điểm xét tuyển</a></li>
                    <li><a href="/hoc-phi">Học phí</a></li>
                    <li><a href="/tuyen-sinh#form-dang-ky">Đăng ký tư vấn</a></li>
                </ul>
            </div>

            <div>
                <h4>Liên hệ</h4>
                <ul class="viu-footer__list viu-footer__contact">
                    <li>
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Số 16 Hữu Nghị, phường Tùng Thiện,<br />thị xã Sơn Tây, Hà Nội</span>
                    </li>
                    <li><i class="fa-solid fa-phone"></i><span>024.3383.8345</span></li>
                    <li><i class="fa-solid fa-envelope"></i><span>tuyensinh@viu.edu.vn</span></li>
                </ul>
            </div>
        </div>

        <div class="viu-footer__bottom">
            <span>© @DateTime.Now.Year Trường Đại học Công nghiệp Việt - Hung</span>
            <span>
                <a href="/lien-he">Liên hệ</a> ·
                <a href="/tai-khoan/dang-nhap">Đăng nhập</a> ·
                <a href="/tim-kiem">Tìm kiếm</a>
            </span>
        </div>
    </div>
</footer>

<!-- ===== Trợ lý tuyển sinh ===== -->
@await Component.InvokeAsync("ChatWidget")

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/site-interactions.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>