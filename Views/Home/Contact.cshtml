@model VIUUniversity.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Liên hệ";
}

<!-- Hero header -->
<div class="bg-primary py-5 text-white" style="background: linear-gradient(135deg, var(--viu-navy) 0%, #1e3a8a 100%);">
    <div class="container py-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Liên hệ</li>
            </ol>
        </nav>
        <h1 class="display-6 fw-bold mb-2">Thông tin liên hệ</h1>
        <p class="lead mb-0 text-white-50">Kết nối với Trường Đại học Công nghiệp Việt - Hung qua các kênh liên lạc chính thức.</p>
    </div>
</div>

<div class="container py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- Form gửi câu hỏi / góp ý -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="viu-eyebrow">Gửi câu hỏi / Phản hồi</div>
                <h3 class="fw-bold mb-3" style="color: var(--viu-navy);">Liên hệ trực tuyến</h3>
                <p class="text-secondary small mb-4">Quý phụ huynh, học sinh và đối tác có thắc mắc cần giải đáp, vui lòng điền biểu mẫu dưới đây. Chúng tôi sẽ phản hồi trong thời gian sớm nhất.</p>

                <form asp-action="SubmitContact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="Message.FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                            <span asp-validation-for="Message.FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
                            <input asp-for="Message.Email" type="email" class="form-control" placeholder="email@example.com" required />
                            <span asp-validation-for="Message.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input asp-for="Message.PhoneNumber" class="form-control" placeholder="09xx.xxx.xxx" />
                            <span asp-validation-for="Message.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Chủ đề <span class="text-danger">*</span></label>
                            <input asp-for="Message.Subject" class="form-control" placeholder="Tuyển sinh / Đào tạo / Hợp tác..." required />
                            <span asp-validation-for="Message.Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Nội dung liên hệ <span class="text-danger">*</span></label>
                            <textarea asp-for="Message.Message" rows="5" class="form-control" placeholder="Nhập nội dung cần hỗ trợ chi tiết tại đây..." required></textarea>
                            <span asp-validation-for="Message.Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-warning fw-semibold px-4 py-2 text-dark rounded-pill">
                                <i class="fa-solid fa-paper-plane me-2"></i>Gửi tin nhắn liên hệ
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Thông tin cơ sở -->
        <div class="col-lg-5">
            <h4 class="fw-bold mb-4" style="color: var(--viu-navy);">Các cơ sở đào tạo</h4>
            <div class="d-flex flex-column gap-3">
                @foreach (var c in Model.Campuses)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-building-columns"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@c.Name</h6>
                                <p class="text-secondary small mb-2"><i class="fa-solid fa-location-dot text-danger me-2"></i>@c.Address</p>
                                <p class="text-secondary small mb-0"><i class="fa-solid fa-phone text-success me-2"></i>024.xxxx.xxxx &middot; info@viu.edu.vn</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-clock text-primary me-2"></i>Thời gian làm việc</h6>
                    <ul class="list-unstyled small text-secondary mb-0">
                        <li class="mb-2 d-flex justify-content-between">
                            <span>Thứ Hai - Thứ Sáu:</span>
                            <strong class="text-dark">07:30 - 17:00</strong>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span>Thứ Bảy & Chủ Nhật:</span>
                            <strong class="text-muted">Nghỉ (Trực tuyển sinh 24/7)</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
