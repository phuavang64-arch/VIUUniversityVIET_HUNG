@model VIUUniversity.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Liên hệ";
    ViewData["Description"] = "Thông tin liên hệ và biểu mẫu gửi câu hỏi tới Trường Đại học Công nghiệp Việt - Hung.";
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-plaza.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Liên hệ</li>
            </ol>
        </nav>
        <h1>Liên hệ</h1>
        <p>Gửi câu hỏi hoặc yêu cầu thông tin tới nhà trường.</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        <div class="split--sidebar">
            <div>
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
                }

                <h2 class="section-title">Gửi câu hỏi</h2>
                <p class="section-sub">Các trường có dấu * là bắt buộc.</p>

                <form method="post" asp-controller="Home" asp-action="SubmitContact" class="panel">
                    <div class="panel__body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="cName">Họ và tên <span aria-hidden="true">*</span></label>
                                <input class="form-control" id="cName" asp-for="Message.FullName" required />
                                <span class="form-error" asp-validation-for="Message.FullName"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cEmail">Email <span aria-hidden="true">*</span></label>
                                <input class="form-control" id="cEmail" type="email" asp-for="Message.Email" required />
                                <span class="form-error" asp-validation-for="Message.Email"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cPhone">Số điện thoại</label>
                                <input class="form-control" id="cPhone" asp-for="Message.PhoneNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="cSubject">Tiêu đề <span aria-hidden="true">*</span></label>
                                <input class="form-control" id="cSubject" asp-for="Message.Subject" required />
                                <span class="form-error" asp-validation-for="Message.Subject"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="cMsg">Nội dung <span aria-hidden="true">*</span></label>
                                <textarea class="form-control" id="cMsg" rows="6" asp-for="Message.Message" required></textarea>
                                <span class="form-error" asp-validation-for="Message.Message"></span>
                            </div>
                        </div>
                    </div>
                    <div class="panel__body pt-0">
                        <button type="submit" class="btn-viu btn-viu-primary">Gửi câu hỏi</button>
                    </div>
                </form>
            </div>

            <aside class="sidebar">
                <figure class="viu-sidebar-photo">
                    @Html.Img("/images/viu/viu-sontay-gate.jpg",
                        "Cổng chính của Cơ sở Sơn Tây",
                        sizes: "(max-width: 991px) 100vw, 320px")
                    <figcaption>Cổng chính — Cơ sở Sơn Tây</figcaption>
                </figure>

                <div class="panel">
                    <div class="panel__body">
                        <h2 class="sidebar__title">Ban Tuyển sinh</h2>
                        <dl class="viu-deflist">
                            <dt>Hotline</dt><dd>024.3383.8345</dd>
                            <dt>Email</dt><dd>tuyensinh@viu.edu.vn</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Campuses.Any())
                {
                    <div class="panel mt-3">
                        <div class="panel__body">
                            <h2 class="sidebar__title">Cơ sở đào tạo</h2>
                            <ul class="list-unstyled mb-0">
                                @foreach (var c in Model.Campuses)
                                {
                                    <li class="mb-3">
                                        <strong style="color:var(--ink);">@c.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(c.Address))
                                        {
                                            <div class="small text-muted">@c.Address</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.Phone))
                                        {
                                            <div class="small text-muted">@c.Phone</div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            @if (Model.Campuses.Any())
                {
                    <figure class="viu-sidebar-photo">
                        @Html.Img("/images/viu/viu-highrise.jpg",
                            "Toà nhà cao tầng của nhà trường",
                            sizes: "(max-width: 991px) 100vw, 320px")
                        <figcaption>Toà nhà giảng dục</figcaption>
                    </figure>
                }
            </aside>
        </div>
    </div>
</section>