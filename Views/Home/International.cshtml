@{
    ViewData["Title"] = "Hợp tác Quốc tế & Doanh nghiệp";
    var partners = ViewBag.Partners as List<VIUUniversity.Models.Partner> ?? new();
}

<!-- Hero header -->
<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, var(--viu-navy-dark) 0%, var(--viu-navy) 60%, #173f6b 100%); border-bottom: 4px solid var(--viu-gold);">
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Hợp tác quốc tế</li>
            </ol>
        </nav>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(242, 183, 5, 0.15); border: 1px solid rgba(242, 183, 5, 0.4); color: var(--viu-gold);">
            <i class="fa-solid fa-earth-americas"></i>
            <span class="small fw-semibold text-uppercase">Hội nhập toàn cầu - Gắn kết doanh nghiệp</span>
        </div>
        <h1 class="display-5 fw-bold mb-3">Hợp tác Quốc tế & Mạng lưới Doanh nghiệp</h1>
        <p class="lead text-white-75 mb-0" style="max-width: 800px;">
            Kế thừa mối quan hệ hữu nghị truyền thống Việt Nam - Hungary từ năm 1977, VIU mở rộng liên kết với hơn 100 doanh nghiệp hàng đầu và các trường đại học quốc tế.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Mối quan hệ Việt Nam - Hungary đặc biệt -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white border-start border-4 border-warning">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="viu-eyebrow">Dấu ấn lịch sử</span>
                <h3 class="fw-bold mb-3" style="color: var(--viu-navy);">Quan hệ Hữu nghị đặc biệt Việt Nam - Hungary</h3>
                <p class="text-secondary leading-relaxed mb-3">
                    VIU là biểu tượng sống động cho tình hữu nghị bền chặt giữa hai dân tộc Việt Nam và Hungary. Từ công trình viện trợ năm 1977, ngày nay nhà trường tiếp tục là cầu nối học thuật quan trọng với các viện trường hàng đầu tại Hungary như Đại học Công nghệ và Kinh tế Budapest (BME), Đại học Obuda, Đại học Debrecen.
                </p>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <div class="p-2 rounded bg-light border small">
                            <i class="fa-solid fa-graduation-cap text-warning me-2"></i><strong>Học bổng Stipendium Hungaricum:</strong> 20+ suất học bổng toàn phần mỗi năm cho sinh viên và giảng viên VIU tu nghiệp tại Hungary.
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 rounded bg-light border small">
                            <i class="fa-solid fa-handshake text-primary me-2"></i><strong>Chương trình 2+2 & 3+1:</strong> Trao đổi sinh viên và cấp bằng kép công nhận chuẩn Châu Âu (ECTS).
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="p-4 rounded-4 bg-light border text-center">
                    <div class="d-flex justify-content-center gap-3 align-items-center mb-3">
                        <div class="fs-1">🇻🇳</div>
                        <i class="fa-solid fa-heart text-danger fs-3"></i>
                        <div class="fs-1">🇭🇺</div>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Gần 50 năm hữu nghị</h6>
                    <p class="small text-muted mb-0">Hợp tác giáo dục, chuyển giao văn hóa và kỹ thuật công nghiệp đỉnh cao.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Mạng lưới doanh nghiệp đồng hành -->
    <div class="mb-5">
        <div class="text-center mb-5">
            <span class="viu-eyebrow">Mạng lưới đối tác</span>
            <h2 class="viu-section-title">Doanh nghiệp Đồng hành & Tuyển dụng</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Mô hình đào tạo "Nhà trường - Doanh nghiệp" giúp 100% sinh viên được thực tập hưởng lương và cơ hội nhận việc làm ngay khi chưa tốt nghiệp.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white viu-card-hover">
                    <div class="p-3 mb-3 bg-light rounded-3 d-flex align-items-center justify-content-center" style="height: 80px;">
                        <i class="fa-solid fa-mobile-screen-button fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Tập đoàn Samsung</h5>
                    <p class="small text-muted mb-3">Đối tác thực tập kỹ thuật công nghệ thông tin và điện tử.</p>
                    <span class="badge bg-primary bg-opacity-10 text-primary small">Tuyển dụng hàng năm</span>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white viu-card-hover">
                    <div class="p-3 mb-3 bg-light rounded-3 d-flex align-items-center justify-content-center" style="height: 80px;">
                        <i class="fa-solid fa-code fa-2x text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">FPT Software</h5>
                    <p class="small text-muted mb-3">Tài trợ học bổng lập trình và tuyển dụng kỹ sư phần mềm.</p>
                    <span class="badge bg-warning bg-opacity-25 text-dark small">Thực tập từ năm 3</span>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white viu-card-hover">
                    <div class="p-3 mb-3 bg-light rounded-3 d-flex align-items-center justify-content-center" style="height: 80px;">
                        <i class="fa-solid fa-tower-broadcast fa-2x text-danger"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Tập đoàn Viettel</h5>
                    <p class="small text-muted mb-3">Phát triển giải pháp hạ tầng viễn thông và an toàn thông tin.</p>
                    <span class="badge bg-danger bg-opacity-10 text-danger small">Hợp tác R&D</span>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white viu-card-hover">
                    <div class="p-3 mb-3 bg-light rounded-3 d-flex align-items-center justify-content-center" style="height: 80px;">
                        <i class="fa-solid fa-tv fa-2x text-success"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">LG Electronics</h5>
                    <p class="small text-muted mb-3">Tiếp nhận sinh viên ngành Điện tử, Cơ khí tự động hóa.</p>
                    <span class="badge bg-success bg-opacity-10 text-success small">Ký túc xá & Trợ cấp</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cơ hội xuất khẩu lao động kỹ sư & Du học -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="viu-eyebrow">Cơ hội quốc tế</span>
                <h3 class="fw-bold mb-3" style="color: var(--viu-navy);">Chương trình Kỹ sư làm việc tại Nhật Bản & Đức</h3>
                <p class="text-secondary leading-relaxed mb-4">
                    VIU liên kết với các nghiệp đoàn và tổ chức đào tạo Nhật Bản, CHLB Đức tuyển chọn sinh viên từ năm 2 tham gia các lớp bồi dưỡng tiếng Nhật, tiếng Đức miễn phí. Sau khi nhận bằng tốt nghiệp, sinh viên được cấp visa kỹ sư sang làm việc với mức thu nhập từ 40 - 70 triệu VNĐ/tháng.
                </p>
                <div class="d-flex gap-3">
                    <a href="/lien-he" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold">Đăng ký tham gia chương trình</a>
                    <a href="/dao-tao" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">Xem các ngành đủ điều kiện</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded-4 bg-light border">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list-check text-warning me-2"></i>Quyền lợi sinh viên tham gia:</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><i class="fa-solid fa-check-circle text-success me-2"></i>Đào tạo ngôn ngữ và kỹ năng văn hóa doanh nghiệp miễn phí tại trường.</li>
                        <li><i class="fa-solid fa-check-circle text-success me-2"></i>Hỗ trợ 100% thủ tục xin visa kỹ sư chuyên nghiệp.</li>
                        <li><i class="fa-solid fa-check-circle text-success me-2"></i>Doanh nghiệp đài thọ vé máy bay và hỗ trợ nơi ở ban đầu.</li>
                        <li><i class="fa-solid fa-check-circle text-success me-2"></i>Cơ hội định cư lâu dài và bảo lãnh người thân.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
