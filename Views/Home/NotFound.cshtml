@{
    // ViewData["Title"] / ["Description"] / ["NoIndex"] do duoc gan trong HomeController.NotFound().
    var attempted = ViewBag.AttemptedPath as string;

    // Cac trang dich thuong gap nhat. Dung lai duong dan that cua site
    // de nguoi dung luon co duong quay lai noi dung thay vi chi con mot nut "Trang chu".
    var shortcuts = new (string Label, string Href)[]
    {
        ("Trang chủ", "/"),
        ("Ngành đào tạo", "/dao-tao"),
        ("Tuyển sinh", "/tuyen-sinh"),
        ("Tin tức", "/tin-tuc"),
        ("Thông báo", "/thong-bao"),
        ("Liên hệ", "/lien-he")
    };
}

<section class="section">
    <div class="wrap">
        <div class="viu-error">
            <p class="viu-error__code" aria-hidden="true">404</p>

            <h1 class="viu-error__title">Không tìm thấy trang này</h1>

            <p class="viu-error__lead">
                Địa chỉ bạn truy cập không tồn tại trên cổng thông tin của Trường Đại học
                Công nghiệp Việt&nbsp;-&nbsp;Hung, hoặc nội dung đã được chuyển sang
                địa chỉ mới.
            </p>

            @if (!string.IsNullOrWhiteSpace(attempted))
            {
                <p class="viu-error__path">
                    Địa chỉ yêu cầu: <code>@attempted</code>
                </p>
            }

            <div class="viu-error__actions">
                <a class="btn-viu btn-viu-primary btn-viu-lg" href="/">Về trang chủ</a>
                <a class="btn-viu btn-viu-ghost btn-viu-lg" href="/tim-kiem">Tìm kiếm nội dung</a>
            </div>

            @* Trang 404 cũng dùng ảnh thật cho khỏi trống: cùng bộ ảnh với
               các trang khác, không cần ảnh riêng. *@
            <figure class="viu-sidebar-photo" style="max-width:460px;margin:0 auto;">
                @Html.Img("/images/viu/viu-main-building.jpg",
                    "Toà nhà chính của Trường Đại học Công nghiệp Việt - Hung",
                    sizes: "(max-width: 991px) 100vw, 460px")
                <figcaption>Toà nhà chính — Cơ sở Sơn Tây, Số 16 Hữu Nghị, phường Tùng Thiện</figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="section section--alt section--tight">
    <div class="wrap">
        <h2 class="section-title h5">Các trang thường truy cập</h2>
        <ul class="viu-error__links">
            @foreach (var s in shortcuts)
            {
                <li><a href="@s.Href">@s.Label</a></li>
            }
        </ul>
        <p class="small text-muted mt-3 mb-0">
            Nếu bạn theo liên kết từ một trang khác và thấy thông báo này, hãy cho chúng tôi
            biết qua <a href="/lien-he">trang liên hệ</a> để kịp sửa.
        </p>
    </div>
</section>