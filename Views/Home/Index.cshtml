@model VIUUniversity.ViewModels.HomeViewModel
@{
    ViewData["Title"] = null;

    var hero = Model.Banners.FirstOrDefault();
    var heroImage = hero?.ImageUrl ?? "/images/viu/viu-plaza.jpg";

    // Bài tin nổi bật: bài mới nhất. Phần còn lại vào danh sách bên dưới.
    var leadNews = Model.LatestNews.FirstOrDefault();
    var sideNews = leadNews is null
        ? Enumerable.Empty<VIUUniversity.Models.News>()
        : Model.LatestNews.Skip(1).Take(4);

    // Dải dịch vụ: chỉ liệt kê những đích đang có thật trong hệ thống.
    var services = new (string Icon, string Title, string Href)[]
    {
        ("fa-graduation-cap", "Ngành đào tạo", "/dao-tao"),
        ("fa-file-signature", "Tuyển sinh", "/tuyen-sinh"),
        ("fa-calculator", "Tính điểm", "/tuyen-sinh/tinh-diem"),
        ("fa-bell", "Thông báo", "/thong-bao"),
    };

    // Thế mạnh chương trình: ảnh thật đi kèm, không phải khối chữ trắng.
    var strengths = new (string Img, string Alt, string Title, string Text, string Href, string Link)[]
    {
        ("/images/viu/viu-khoa-cntt.jpg",
         "Sinh viên Khoa Công nghệ thông tin làm việc nhóm trên máy tính",
         "Học gắn với thực hành",
         "Chương trình dành thời lượng lớn cho thực hành tại phòng thí nghiệm và xưởng.",
         "/dao-tao", "Xem chương trình"),
        ("/images/viu/viu-khoa-dien.jpg",
         "Sinh viên Khoa Điện – Điện tử thực hành trên mô hình mạch điện",
         "Môi trường kỹ thuật",
         "Phòng máy tính, xưởng điện tử – cơ khí phục vụ học tập và nghiên cứu sinh viên.",
         "/dao-tao", "Xem chương trình"),
        ("/images/viu/viu-signing.jpg",
         "Lễ ký kết hợp tác toàn diện tại nhà trường",
         "Hợp tác doanh nghiệp",
         "Kết nối doanh nghiệp phục vụ thực tập và định hướng nghề nghiệp cho sinh viên.",
         "/hop-tac", "Tìm hiểu hợp tác"),
        ("/images/viu/viu-thachthat.jpg",
         "Cơ sở đào tạo Thạch Thất của nhà trường",
         "Nhiều cơ sở đào tạo",
         "Hoạt động đào tạo trực tiếp tại các cơ sở trên địa bàn Hà Nội.",
         "/gioi-thieu", "Giới thiệu nhà trường"),
    };

    // Cơ sở đào tạo: ảnh thật thay cho các khối chữ trắng.
    var campusPhotos = new (string Img, string Alt, string Name)[]
    {
        ("/images/viu/viu-sontay-gate.jpg",
         "Cổng chính của Cơ sở Sơn Tây",
         "Cơ sở Sơn Tây"),
        ("/images/viu/viu-thachthat.jpg",
         "Khuôn viên Cơ sở Thạch Thất",
         "Cơ sở Thạch Thất"),
        ("/images/viu/viu-garden.jpg",
         "Khuôn viên cây xanh và bảng tên nhà trường",
         "Khuôn viên nhà trường"),
        ("/images/viu/viu-main-building.jpg",
         "Toà nhà chính nhìn từ sân trường",
         "Toà nhà chính"),
        ("/images/viu/viu-highrise.jpg",
         "Toà nhà cao tầng của nhà trường",
         "Khu giảng đường"),
        ("/images/viu/viu-hall.jpg",
         "Hội trường với hàng ghế phục vụ sự kiện",
         "Hội trường"),
    };

    // Đời sống sinh viên — dải ảnh thật dẫn sang trang Cổng sinh viên.
    var lifePhotos = new (string Img, string Alt, string Caption)[]
    {
        ("/images/viu/viu-students-open-day.jpg", "Tập thể sinh viên trước bảng tên trường", "Tập thể sinh viên"),
        ("/images/viu/viu-hoi-tnvn.jpg", "Sinh viên tập dượt Hội Thanh niên Việt", "Hội Thanh niên Việt"),
        ("/images/viu/viu-football-cup.jpg", "Cúp bóng đá do trường tổ chức", "Cúp bóng đá"),
        ("/images/viu/viu-clb-ngoai-khoa.jpg", "CLB Ngoại khoa biểu diễn tại sân trường", "CLB Ngoại khoa"),
        ("/images/viu/viu-clb-vo.jpg", "CLB Võ múa tại sân trường", "CLB Võ"),
        ("/images/viu/viu-students-ao-dai.jpg", "Sinh viên trước cổng trường", "Sinh viên nhà trường"),
    };
}

@* ================= Hero: ảnh trên, tiêu đề dưới — nền trắng ================= *@
<section class="viu-hero">
    @Html.Img("/images/viu/viu-plaza.jpg",
        "Sân trường Trường Đại học Công nghiệp Việt - Hung nhìn từ toà nhà chính",
        "viu-hero__media", eager: true, sizes: "100vw")
    <div class="wrap">
        <div class="viu-hero__text">
            <span class="eyebrow">Tuyển sinh đại học chính quy</span>
            <h1>@(hero?.Title ?? "Tuyển sinh đại học năm 2026")</h1>
            <p>
                @(hero?.Description
                  ?? "Trường Đại học Công nghiệp Việt - Hung đào tạo theo hợp tác Việt Nam – Hungary, " +
                     "chương trình được thiết kế với thời lượng thực hành lớn và gắn với nhu cầu lao động.")
            </p>
            <div class="viu-hero__actions">
                <a class="btn-viu btn-viu-primary btn-viu-lg" href="/tuyen-sinh">Thông tin tuyển sinh</a>
                <a class="btn-viu btn-viu-outline btn-viu-lg" href="/dao-tao">Khám phá ngành học</a>
            </div>
            <ul class="viu-hero__facts">
                <li><i class="fa-solid fa-school" aria-hidden="true"></i> Mã trường <strong>VHD</strong></li>
                <li><i class="fa-solid fa-handshake" aria-hidden="true"></i> Hợp tác <strong>Việt Nam – Hungary</strong></li>
                <li><i class="fa-solid fa-flask" aria-hidden="true"></i> Thực hành <strong>chiếm phần lớn thời lượng</strong></li>
            </ul>
        </div>
    </div>
</section>

@* ================= Dải dịch vụ nhanh ================= *@
<section class="viu-services">
    <div class="wrap">
        <div class="viu-services__grid">
            @foreach (var s in services)
            {
                <a class="viu-services__item" href="@s.Href">
                    <i class="fa-solid @s.Icon" aria-hidden="true"></i>
                    <strong>@s.Title</strong>
                </a>
            }
        </div>
    </div>
</section>

@* ================= Giới thiệu nhà trường ================= *@
<section class="section">
    <div class="wrap">
        <div class="viu-media-split">
            <div class="viu-media-split__media viu-media-collage">
                <div class="viu-media-collage__main">
                    @Html.Img("/images/viu/viu-aerial.jpg",
                        "Toàn cảnh cơ sở đào tạo của Trường Đại học Công nghiệp Việt - Hung nhìn từ trên cao",
                        sizes: "(max-width: 991px) 100vw, 50vw")
                </div>
                <div class="viu-media-collage__sub">
                    @Html.Img("/images/viu/viu-garden.jpg",
                        "Khuôn viên cây xanh và bảng tên nhà trường",
                        sizes: "(max-width: 991px) 50vw, 24vw")
                </div>
            </div>
            <div>
                <span class="eyebrow">Về chúng tôi</span>
                <h2 class="section-title">Giới thiệu nhà trường</h2>
                <p class="lead-viu">
                    Trường Đại học Công nghiệp Việt - Hung là cơ sở giáo dục đại học công lập trực thuộc
                    Bộ Công Thương, hoạt động theo hợp tác Việt Nam - Hungary. Chương trình đào tạo
                    được thiết kế với thời lượng thực hành lớn, gắn với nhu cầu lao động thực tế.
                </p>
                <ul class="viu-check-list">
                    <li>Chương trình đào tạo hợp tác với các cơ sở trong nước và Hungary.</li>
                    <li>Quy mô đào tạo trực tiếp tại nhiều cơ sở trên địa bàn Hà Nội.</li>
                    <li>Đội ngũ giảng viên có kinh nghiệm thực tiễn từ doanh nghiệp.</li>
                </ul>
                <a class="btn-viu btn-viu-outline" href="/gioi-thieu">Tìm hiểu về nhà trường</a>
            </div>
        </div>
    </div>
</section>

@* ================= Dải ảnh toàn ngang ================= *@
<section class="viu-photo-band">
    <div class="viu-photo-band__media">
        @Html.Img("/images/viu/viu-students-open-day.jpg",
            "Tập thể sinh viên Trường Đại học Công nghiệp Việt - Hung trước bảng tên trường",
            sizes: "100vw")
        <div class="viu-photo-band__caption">
            <div class="wrap">
                <h2 class="viu-photo-band__title">Một trường, một cộng đồng sinh viên</h2>
                <p class="viu-photo-band__text">
                    Học tập, thực hành và sinh hoạt đoàn thể diễn ra ngay trong khuôn
                    viên các cơ sở của nhà trường.
                </p>
            </div>
        </div>
    </div>
</section>

@* ================= Tin tức + Sự kiện/Thông báo (bố cục 7/5 như HaUI) ================= *@
@if (Model.LatestNews.Any() || Model.UpcomingEvents.Any() || Model.LatestAnnouncements.Any())
{
    <section class="section section--alt">
        <div class="wrap">
            <div class="viu-split-news">

                @* ---- Cột trái: Tin tức ---- *@
                <div>
                    <h2 class="section-title">Tin tức</h2>

                    @if (leadNews != null)
                    {
                        <article class="viu-post-lead">
                            <a class="viu-post-lead__media" href="/tin-tuc/@leadNews.Slug">
                                @Html.Img(leadNews.Thumbnail, leadNews.Title,
                                    sizes: "(max-width: 991px) 100vw, 55vw")
                            </a>
                            <h3 class="viu-post-lead__title">
                                <a href="/tin-tuc/@leadNews.Slug">@leadNews.Title</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(leadNews.Summary))
                            {
                                <p class="viu-post-lead__excerpt">@leadNews.Summary</p>
                            }
                            <p class="viu-post-item__meta">
                                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                @leadNews.PublishedAt?.ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrWhiteSpace(leadNews.Category?.Name))
                                {
                                    <span>· @leadNews.Category!.Name</span>
                                }
                            </p>
                        </article>
                    }

                    @if (sideNews.Any())
                    {
                        foreach (var n in sideNews)
                        {
                            <article class="viu-post-item">
                                <a class="viu-post-item__media" href="/tin-tuc/@n.Slug" tabindex="-1" aria-hidden="true">
                                    @Html.Img(n.Thumbnail, "", sizes: "170px")
                                </a>
                                <h3 class="viu-post-item__title">
                                    <a href="/tin-tuc/@n.Slug">@n.Title</a>
                                </h3>
                                <p class="viu-post-item__meta">
                                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                    @n.PublishedAt?.ToString("dd/MM/yyyy")
                                </p>
                            </article>
                        }
                        <a class="btn-viu btn-viu-ghost mt-4" href="/tin-tuc">Xem tất cả tin tức</a>
                    }
                </div>

                @* ---- Cột phải: Sự kiện + Thông báo ---- *@
                <div>
                    @if (Model.UpcomingEvents.Any())
                    {
                        <h2 class="section-title">Sự kiện sắp tới</h2>
                        <ul class="viu-list mb-5">
                            @foreach (var e in Model.UpcomingEvents.Take(6))
                            {
                                <li>
                                    <a href="/su-kien/@e.Slug">
                                        <span>@e.Title</span>
                                        <span class="viu-list__date">@e.StartAt.ToString("dd/MM/yyyy")</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <a class="btn-viu btn-viu-ghost mb-5" href="/su-kien">Xem tất cả sự kiện</a>
                    }

                    @if (Model.LatestAnnouncements.Any())
                    {
                        <h2 class="section-title">Thông báo</h2>
                        <ul class="viu-list">
                            @foreach (var a in Model.LatestAnnouncements.Take(8))
                            {
                                <li>
                                    <a href="/thong-bao/@a.Id">
                                        <span>@a.Title</span>
                                        <span class="viu-list__date">@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <a class="btn-viu btn-viu-ghost mt-4" href="/thong-bao">Xem tất cả thông báo</a>
                    }
                </div>

            </div>
        </div>
    </section>
}

@* ================= Khoa đào tạo ================= *@
@if (Model.Departments.Any())
{
    <section class="section">
        <div class="wrap">
            <h2 class="section-title">Các khoa và ngành đào tạo</h2>
            <div class="viu-dept-grid viu-reveal">
                @foreach (var d in Model.Departments)
                {
                    var img = !string.IsNullOrWhiteSpace(d.Image) ? d.Image : d.Logo;
                    <a class="viu-dept-card" href="/dao-tao/khoa/@d.Slug">
                        <span class="viu-dept-card__media">
                            @Html.Img(img, "Hình ảnh " + d.Name,
                                sizes: "(max-width: 767px) 100vw, 33vw",
                                fallback: "/images/departments/khoa-cntt.jpg")
                        </span>
                        <span class="viu-dept-card__code">Mã khoa @d.Code</span>
                        <span class="viu-dept-card__name">@d.Name</span>
                        @if (!string.IsNullOrWhiteSpace(d.Description))
                        {
                            <span class="viu-dept-card__desc">@d.Description</span>
                        }
                        <span class="viu-dept-card__foot">@d.Majors.Count ngành đào tạo ›</span>
                    </a>
                }
            </div>
            <div class="mt-4">
                <a class="btn-viu btn-viu-outline" href="/dao-tao">Xem tất cả ngành đào tạo</a>
            </div>
        </div>
    </section>
}

@* ================= Thế mạnh chương trình (có ảnh) ================= *@
<section class="section section--alt">
    <div class="wrap">
        <h2 class="section-title">Thế mạnh của chương trình đào tạo</h2>
        <div class="viu-features">
            @foreach (var s in strengths)
            {
                <article class="viu-feature-card">
                    <span class="viu-feature-card__media">
                        @Html.Img(s.Img, s.Alt, sizes: "(max-width: 1080px) 50vw, 25vw")
                    </span>
                    <div class="viu-feature-card__body">
                        <h3>@s.Title</h3>
                        <p>@s.Text</p>
                        <a class="link-action d-inline-flex align-items-center mt-3" href="@s.Href">
                            @s.Link <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@* ================= Cơ sở đào tạo ================= *@
<section class="section">
    <div class="wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow">Hạ tầng</span>
                <h2 class="section-title section-title--plain mb-0">Hệ thống cơ sở đào tạo</h2>
            </div>
            <a class="btn-viu btn-viu-ghost" href="/gioi-thieu">Thông tin cơ sở</a>
        </div>
        <div class="viu-photo-grid viu-photo-grid--3 viu-reveal">
            @foreach (var c in campusPhotos)
            {
                <figure>
                    @Html.Img(c.Img, c.Alt, sizes: "(max-width: 767px) 100vw, 33vw")
                    <figcaption>@c.Name</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

@* ================= Đời sống sinh viên ================= *@
<section class="section section--alt">
    <div class="wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <span class="eyebrow">Sinh viên</span>
                <h2 class="section-title section-title--plain mb-0">Đời sống sinh viên</h2>
            </div>
            <a class="btn-viu btn-viu-ghost" href="/sinh-vien">Cổng sinh viên</a>
        </div>
        <div class="viu-photo-grid viu-photo-grid--3 viu-reveal">
            @foreach (var p in lifePhotos)
            {
                <figure>
                    @Html.Img(p.Img, p.Alt, sizes: "(max-width: 767px) 100vw, 33vw")
                    <figcaption>@p.Caption</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

@* ================= Hợp tác ================= *@
@if (Model.Partners.Any())
{
    <section class="section section--tight section--alt">
        <div class="wrap">
            <h2 class="section-title">Hợp tác và đối tác</h2>
            <div class="viu-partners">
                @foreach (var p in Model.Partners)
                {
                    @if (!string.IsNullOrWhiteSpace(p.Website))
                    {
                        <a class="viu-partners__item" href="@p.Website" target="_blank" rel="noopener">@p.Name</a>
                    }
                    else
                    {
                        <span class="viu-partners__item">@p.Name</span>
                    }
                }
            </div>
            <div class="mt-4">
                <a class="btn-viu btn-viu-ghost" href="/hop-tac">Chi tiết hợp tác</a>
            </div>
        </div>
    </section>
}

@* ================= Kêu gọi tuyển sinh ================= *@
<section class="section section--tight">
    <div class="wrap">
        <div class="viu-cols viu-reveal" style="gap:2.5rem;">
            <div>
                <h2 class="section-title section-title--plain mb-2">Cần tư vấn tuyển sinh?</h2>
                <p class="mb-0" style="color:var(--ink-muted);max-width:56ch;">
                    Ban Tuyển sinh sẵn sàng hỗ trợ bạn chọn ngành và hoàn thiện hồ sơ phù hợp.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a class="btn-viu btn-viu-primary" href="/tuyen-sinh#form-dang-ky">Đăng ký tư vấn</a>
                <a class="btn-viu btn-viu-outline" href="/tuyen-sinh/tra-cuu-diem-chuan">Tra cứu điểm chuẩn</a>
            </div>
        </div>
    </div>
</section>