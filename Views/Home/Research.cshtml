@{
    ViewData["Title"] = "Nghiên cứu khoa học & Chuyển giao công nghệ";
}

<!-- Hero header -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, var(--viu-navy-dark) 0%, var(--viu-navy) 60%, #173f6b 100%); border-bottom: 4px solid var(--viu-gold);">
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Nghiên cứu khoa học</li>
            </ol>
        </nav>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(242, 183, 5, 0.15); border: 1px solid rgba(242, 183, 5, 0.4); color: var(--viu-gold);">
            <i class="fa-solid fa-atom"></i>
            <span class="small fw-semibold text-uppercase">Nghiên cứu - Phát triển - Đổi mới sáng tạo</span>
        </div>
        <h1 class="display-5 fw-bold mb-3">Nghiên cứu khoa học & Chuyển giao công nghệ</h1>
        <p class="lead text-white-75 mb-0" style="max-width: 800px;">
            Đẩy mạnh các công trình nghiên cứu gắn với thực tiễn sản xuất công nghiệp, giải quyết bài toán của các nhà máy, xí nghiệp thuộc ngành Công Thương.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Stats Highlight -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="p-4 rounded-4 bg-white shadow-sm border border-light text-center h-100">
                <div class="h2 fw-bold text-primary mb-1">120+</div>
                <div class="text-muted small">Đề tài NCKH các cấp/năm</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 rounded-4 bg-white shadow-sm border border-light text-center h-100">
                <div class="h2 fw-bold text-primary mb-1">45+</div>
                <div class="text-muted small">Bài báo Scopus / ISI uy tín</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 rounded-4 bg-white shadow-sm border border-light text-center h-100">
                <div class="h2 fw-bold text-primary mb-1">15+</div>
                <div class="text-muted small">Bằng sáng chế & Giải pháp hữu ích</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 rounded-4 bg-white shadow-sm border border-light text-center h-100">
                <div class="h2 fw-bold text-primary mb-1">30+</div>
                <div class="text-muted small">Dự án chuyển giao công nghệ</div>
            </div>
        </div>
    </div>

    <!-- Main Research Tracks -->
    <div class="mb-5">
        <div class="text-center mb-5">
            <span class="viu-eyebrow">Trọng tâm</span>
            <h2 class="viu-section-title">Lĩnh vực nghiên cứu mũi nhọn</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Nhà trường tập trung nguồn lực phát triển các hướng nghiên cứu hiện đại theo xu thế chuyển đổi số và chuyển đổi xanh.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="p-3 rounded-circle text-primary bg-primary bg-opacity-10 d-inline-flex mb-3" style="width: 56px; height: 56px; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-microchip fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Trí tuệ nhân tạo & IoT công nghiệp</h5>
                    <p class="text-secondary small mb-3">Ứng dụng mạng nơ-ron học sâu, thị giác máy tính và cảm biến thông minh vào giám sát dây chuyền sản xuất tự động.</p>
                    <span class="badge bg-light text-primary align-self-start border">Khoa CNTT chủ trì</span>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="p-3 rounded-circle text-warning bg-warning bg-opacity-15 d-inline-flex mb-3" style="width: 56px; height: 56px; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-solar-panel fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Năng lượng tái tạo & Lưới điện thông minh</h5>
                    <p class="text-secondary small mb-3">Nghiên cứu tối ưu hóa hệ thống điện mặt trời, pin lưu trữ dung lượng cao và quản lý năng lượng tiết kiệm trong công nghiệp.</p>
                    <span class="badge bg-light text-warning text-dark align-self-start border">Khoa Điện - Điện tử chủ trì</span>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="p-3 rounded-circle text-success bg-success bg-opacity-10 d-inline-flex mb-3" style="width: 56px; height: 56px; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-robot fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Tự động hóa & Robot công nghiệp</h5>
                    <p class="text-secondary small mb-3">Thiết kế chế tạo tay máy robot công nghiệp, hệ thống xe tự hành AGV vận chuyển hàng trong kho thông minh.</p>
                    <span class="badge bg-light text-success align-self-start border">Trung tâm Thực nghiệm chủ trì</span>
                </div>
            </div>
        </div>
    </div>

    <!-- NCKH Sinh viên -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="viu-eyebrow">Phong trào học thuật</span>
                <h3 class="fw-bold mb-3" style="color: var(--viu-navy);">Nghiên cứu khoa học trong sinh viên</h3>
                <p class="text-secondary leading-relaxed mb-4">
                    Nhà trường có quỹ hỗ trợ tài chính đặc biệt dành cho sinh viên tham gia nghiên cứu khoa học và khởi nghiệp sáng tạo. Hàng năm, giải thưởng "Sinh viên Nghiên cứu khoa học VIU" thu hút hơn 300 sinh viên tham gia với nhiều sản phẩm có khả năng ứng dụng thương mại.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-trophy text-warning me-1"></i>Giải thưởng NCKH cấp Bộ</span>
                    <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-lightbulb text-primary me-1"></i>Vườn ươm Khởi nghiệp VIU</span>
                    <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-dollar-sign text-success me-1"></i>Quỹ hỗ trợ 500 triệu/năm</span>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="p-4 rounded-4" style="background: linear-gradient(135deg, var(--viu-navy) 0%, #1d4ed8 100%); color: white;">
                    <i class="fa-solid fa-award fa-3x text-warning mb-3"></i>
                    <h5 class="fw-bold mb-2">Cuộc thi Ý tưởng Khởi nghiệp 2026</h5>
                    <p class="small text-white-75 mb-3">Dành cho toàn thể sinh viên và cựu sinh viên VIU. Tổng giá trị giải thưởng lên đến 150 triệu đồng.</p>
                    <a href="/lien-he" class="btn btn-warning text-dark fw-bold btn-sm rounded-pill px-4">Đăng ký tham gia đề tài</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tạp chí & Công bố khoa học -->
    <div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="viu-eyebrow">Ấn phẩm học thuật</span>
                <h3 class="fw-bold mb-0" style="color: var(--viu-navy);">Tạp chí Khoa học & Công nghệ VIU</h3>
            </div>
            <a href="/lien-he" class="btn btn-outline-primary btn-sm rounded-pill px-3">Gửi bài báo <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Số 42 - Chuyên đề Trí tuệ nhân tạo và Tự động hóa</h6>
                        <span class="small text-muted">Xuất bản: Tháng 03/2026 &middot; Chỉ số ISSN: 1859-xxxx</span>
                    </div>
                    <span class="badge bg-success">Mới nhất</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Số 41 - Kinh tế số và Quản trị chuỗi cung ứng</h6>
                        <span class="small text-muted">Xuất bản: Tháng 12/2025 &middot; Chỉ số ISSN: 1859-xxxx</span>
                    </div>
                    <span class="badge bg-secondary">Lưu trữ</span>
                </div>
            </div>
        </div>
    </div>
</div>
