@model VIUUniversity.Models.Department
@{
    ViewData["Title"] = Model.Name;
    ViewData["Description"] = Model.Description ?? $"Thông tin {Model.Name} tại Trường Đại học Công nghiệp Việt - Hung.";
    var img = !string.IsNullOrWhiteSpace(Model.Image) ? Model.Image : Model.Logo;
    var gallery = ViewBag.DepartmentGallery as List<VIUUniversity.Models.GalleryImage> ?? new();
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('@(img ?? "/images/viu/viu-garden.jpg")');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/dao-tao">Đào tạo</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h1>@Model.Name</h1>
        <p>Mã khoa: @Model.Code</p>
    </div>
</div>

<section class="section">
    <div class="wrap split--sidebar">
        <div>
            @if (!string.IsNullOrWhiteSpace(img))
            {
                <figure style="margin:0 0 1.5rem;">
                    <div class="viu-dept-hero">
                        @Html.Img(img, "Hình ảnh đại diện " + Model.Name,
                                    sizes: "(max-width: 991px) 100vw, 50vw")
                    </div>
                    <figcaption class="small text-muted" style="margin-top:.5rem;">
                        Hình ảnh @Model.Name
                    </figcaption>
                </figure>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <h2 class="section-title">Giới thiệu</h2>
                <div class="viu-prose mb-4">
                    <p>@Model.Description</p>
                </div>
            }

            <h2 class="section-title mt-4">Ngành đào tạo thuộc khoa</h2>
            @if (Model.Majors.Any())
            {
                <div class="panel">
                    <div class="table-scroll">
                        <table class="table-viu">
                            <thead>
                                <tr>
                                    <th style="width:110px;">Mã ngành</th>
                                    <th>Tên ngành</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Majors)
                                {
                                    <tr>
                                        <td style="font-variant-numeric:tabular-nums;font-weight:600;">@m.Code</td>
                                        <td><a href="/dao-tao/nganh/@m.Slug">@m.Name</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <strong>Chưa có ngành đào tạo</strong>
                    Khoa chưa có ngành nào được công bố.
                </div>
            }

            @if (Model.Lecturers.Any())
            {
                <h2 class="section-title mt-4">Đội ngũ giảng viên</h2>
                <ul class="list-unstyled mb-0">
                    @foreach (var l in Model.Lecturers.Take(8))
                    {
                        <li class="py-2" style="border-bottom:1px solid var(--line-soft);">
                            <div style="font-weight:600;font-size:.94rem;">
                                @l.FullName
                                @if (!string.IsNullOrWhiteSpace(l.AcademicTitle))
                                {
                                    <span class="text-muted" style="font-weight:400;"> — @l.AcademicTitle</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(l.Biography))
                            {
                                <div class="small text-muted mt-1">@l.Biography</div>
                            }
                        </li>
                    }
                </ul>
                @if (Model.Lecturers.Count > 8)
                {
                    <a class="btn-viu btn-viu-outline btn-viu-sm mt-3" href="/dao-tao/giang-vien">
                        Xem toàn bộ @Model.Lecturers.Count giảng viên
                    </a>
                }
            }

            @if (gallery.Any())
            {
                <h2 class="section-title mt-4">Cơ sở vật chất và hoạt động</h2>
                <div class="row g-3">
                    @foreach (var g in gallery)
                    {
                        <div class="col-md-4">
                            <figure style="margin:0;">
                                <div style="border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--surface-sunken);">
                                    @Html.Img(g.ImageUrl, g.Caption,
                                         sizes: "(max-width: 767px) 100vw, 33vw",
                                         style: "width:100%;aspect-ratio:4/3;object-fit:cover;display:block;")
                                </div>
                                <figcaption class="small text-muted" style="margin-top:.4rem;">@g.Caption</figcaption>
                            </figure>
                        </div>
                    }
                </div>
            }
        </div>

        <aside class="sidebar">
            <div class="panel">
                <div class="panel__body">
                    <h2 class="sidebar__title">Thông tin khoa</h2>
                    <dl class="viu-deflist" style="grid-template-columns:1fr;">
                        <dt>Mã khoa</dt><dd>@Model.Code</dd>
                        <dt>Số ngành đào tạo</dt><dd>@Model.Majors.Count</dd>
                        <dt>Số giảng viên</dt>
                        <dd>@(Model.Lecturers.Count > 0 ? Model.Lecturers.Count.ToString() : "Chưa cập nhật")</dd>
                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)</dd>
                        <dt>Điện thoại</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</dd>
                        <dt>Địa chỉ</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</dd>
                    </dl>
                </div>
            </div>

            <div class="sidebar__group mt-3">
                <a class="btn-viu btn-viu-primary btn-viu-block" href="/tuyen-sinh">Thông tin tuyển sinh</a>
                <a class="btn-viu btn-viu-ghost btn-viu-block mt-2" href="/lien-he">Liên hệ khoa</a>
            </div>
        </aside>
    </div>
</section>