@model VIUUniversity.Models.Major
@{
    ViewData["Title"] = $"Ngành {Model.Name}";
    ViewData["Description"] = Model.Description ?? $"Chương trình đào tạo ngành {Model.Name} tại VIU.";
    var subjects = Model.Subjects.OrderBy(s => s.Code).ToList();
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-khoa-dien.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/dao-tao">Đào tạo</a></li>
                @if (Model.Department != null)
                {
                    <li class="breadcrumb-item">
                        <a href="/dao-tao/khoa/@Model.Department.Slug">@Model.Department.Name</a>
                    </li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <h1>@Model.Name</h1>
        <p>
            Mã ngành: <strong>@Model.Code</strong>
            @if (!string.IsNullOrWhiteSpace(Model.DegreeLevel))
            {
                <span> · @Model.DegreeLevel</span>
            }
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap split--sidebar">
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <figure style="margin:0 0 1.5rem;">
                    <div class="viu-dept-hero">
                        @Html.Img(Model.ImageUrl, "Hình ảnh ngành " + Model.Name,
                                sizes: "(max-width: 991px) 100vw, 50vw")
                    </div>
                    <figcaption class="small text-muted" style="margin-top:.5rem;">
                        Hình ảnh ngành @Model.Name
                    </figcaption>
                </figure>
            }

            <h2 class="section-title">Giới thiệu chương trình</h2>
            <div class="viu-prose">
                @if (Html.HasText(Model.Description))
                {
                    @Html.Paragraphs(Model.Description)
                }
                else
                {
                    <div class="empty-state">
                        <strong>Chưa có mô tả chi tiết</strong>
                        Nhà trường đang hoàn thiện nội dung cho ngành này.
                    </div>
                }
            </div>

            @if (Html.HasText(Model.SkillsDescription))
            {
                <h2 class="section-title mt-4">Kiến thức và kỹ năng được đào tạo</h2>
                <div class="viu-prose">@Html.Paragraphs(Model.SkillsDescription)</div>
            }

            @if (Html.HasText(Model.DurationDescription))
            {
                <h2 class="section-title mt-4">Thời gian đào tạo</h2>
                <div class="viu-prose">@Html.Paragraphs(Model.DurationDescription)</div>
            }

            @if (Html.HasText(Model.CareerDescription))
            {
                <h2 class="section-title mt-4">Cơ hội nghề nghiệp</h2>
                <div class="viu-prose">@Html.Paragraphs(Model.CareerDescription)</div>
            }

            <h2 class="section-title mt-4">Chương trình đào tạo</h2>
            @if (subjects.Any())
            {
                <p class="text-muted mb-3" style="font-size:.9rem;">
                    Danh sách môn học tiêu biểu của chương trình.
                </p>
                <div class="panel">
                    <div class="table-scroll">
                        <table class="viu-courses">
                            <thead>
                                <tr>
                                    <th style="width:110px;">Mã môn</th>
                                    <th>Tên môn học</th>
                                    <th class="credits" style="width:90px;">Tín chỉ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in subjects)
                                {
                                    <tr>
                                        <td style="font-variant-numeric:tabular-nums;font-weight:600;">@s.Code</td>
                                        <td>
                                            @s.Name
                                            @if (!string.IsNullOrWhiteSpace(s.Description))
                                            {
                                                <div class="small text-muted">@s.Description</div>
                                            }
                                        </td>
                                        <td class="credits">@s.Credits</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <strong>Chưa công bố khung chương trình</strong>
                    Danh sách môn học sẽ được cập nhật sau.
                </div>
            }
        </div>

        <aside class="sidebar">
            <div class="panel">
                <div class="panel__body">
                    <h2 class="sidebar__title">Thông tin ngành</h2>
                    <dl class="viu-deflist">
                        <dt>Mã ngành</dt><dd>@Model.Code</dd>
                        <dt>Bậc đào tạo</dt><dd>@(string.IsNullOrWhiteSpace(Model.DegreeLevel) ? "Chưa cập nhật" : Model.DegreeLevel)</dd>
                        <dt>Thời gian đào tạo</dt>
                        <dd>
                            @if (Model.DurationYears > 0)
                            {
                                <span>@Model.DurationYears năm</span>
                            }
                            @if (Html.HasText(Model.DurationDescription))
                            {
                                @if (Model.DurationYears > 0)
                                {
                                    <span><br /></span>
                                }
                                <span class="small">@Model.DurationDescription</span>
                            }
                            @if (Model.DurationYears <= 0 && !Html.HasText(Model.DurationDescription))
                            {
                                <span class="text-faint">Chưa cập nhật</span>
                            }
                        </dd>
                        <dt>Học phí</dt>
                        <dd>
                            @if (Model.Tuition > 0)
                            {
                                @Model.Tuition.ToString("N0")<span> đồng/năm</span>
                            }
                            else
                            {
                                @* Không tự đặt mức giá: học phí đổi theo từng năm tuyển
                                   sinh và phải lấy từ văn bản chính thức. *@
                                <span class="text-faint">Chưa công bố</span><br />
                                <a class="small" href="/hoc-phi">Xem văn bản học phí</a>
                            }
                        </dd>
                        <dt>Khoa</dt>
                        <dd>
                            @if (Model.Department != null)
                            {
                                <a href="/dao-tao/khoa/@Model.Department.Slug">@Model.Department.Name</a>
                            }
                            else
                            {
                                <span class="text-faint">Chưa cập nhật</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (Html.HasText(Model.CareerDescription))
            {
                <div class="panel mt-3">
                    <div class="panel__body">
                        <h2 class="sidebar__title">Nghề nghiệp</h2>
                        @Html.FirstParagraph(Model.CareerDescription)
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
            {
                <div class="panel mt-3">
                    <div class="panel__body">
                        <h2 class="sidebar__title">Nguồn</h2>
                        <p class="small mb-1">
                            Mã ngành, tên ngành và nội dung trên trang này được trích từ
                            trang giới thiệu ngành trên cổng tuyển sinh chính thức của Trường.
                        </p>
                        <a class="small" href="@Model.SourceUrl" target="_blank" rel="noopener nofollow">
                            Xem trang nguồn
                            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            }

            <div class="sidebar__group mt-3">
                <a class="btn-viu btn-viu-primary btn-viu-block" href="/tuyen-sinh/tra-cuu-diem-chuan">Điểm chuẩn ngành này</a>
                <a class="btn-viu btn-viu-ghost btn-viu-block mt-2" href="/tuyen-sinh#form-dang-ky">Đăng ký xét tuyển</a>
            </div>
        </aside>
    </div>
</section>