@model VIUUniversity.ViewModels.AcademicIndexViewModel
@{
    ViewData["Title"] = "Đào tạo";
    ViewData["Description"] = "Tổng quan các khoa và ngành đào tạo tại Trường Đại học Công nghiệp Việt - Hung.";
    string? filter = Context.Request.Query["khoa"].ToString();
    string? keyword = Context.Request.Query["keyword"].ToString();

    // Lọc khoa + tìm tên/mã ngành. Tìm kiếm phía client vì toàn bộ danh mục
    // chỉ có 21 ngành, không cần round-trip cho mỗi phím gõ.
    var searched = Model.Majors;
    if (!string.IsNullOrWhiteSpace(keyword))
    {
        var kw = keyword.Trim();
        searched = searched.Where(m =>
            m.Name.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
            (m.Code ?? "").Contains(kw, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    var majors = string.IsNullOrWhiteSpace(filter)
        ? searched
        : searched.Where(m => m.Department != null && m.Department.Id.ToString() == filter).ToList();
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-khoa-cntt.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đào tạo</li>
            </ol>
        </nav>
        <h1>Chương trình đào tạo</h1>
        <p>Các khoa và ngành đào tạo đại học chính quy đang mở tại nhà trường.</p>
    </div>
</div>

<!-- ===== Khoa ===== -->
<section class="section">
    <div class="wrap">
        <div class="sec-head">
            <div>
                <span class="eyebrow">Cơ cấu</span>
                <h2 class="sec-head__title">Các khoa</h2>
            </div>
        </div>
        <p class="section-sub">Chọn một khoa để xem các ngành đào tạo thuộc khoa và thông tin chi tiết.</p>

        @if (Model.Departments.Any())
        {
            @* Lưới CSS riêng thay cho .row của Bootstrap — gutter ngang dùng margin âm,
               dễ đẩy nội dung tràn ra ngoài khung nhìn ở kích thước hẹp. *@
            <div class="viu-dept-grid">
                @foreach (var d in Model.Departments)
                {
                    var img = !string.IsNullOrWhiteSpace(d.Image) ? d.Image : d.Logo;
                    <a class="viu-dept-card" href="/dao-tao/khoa/@d.Slug">
                        @if (!string.IsNullOrWhiteSpace(img))
                        {
                            <span class="viu-dept-card__media">
                                @Html.Img(img, "Hình ảnh " + d.Name,
                                    sizes: "(max-width: 767px) 100vw, 33vw",
                                    fallback: "/images/departments/khoa-cntt.jpg")
                            </span>
                        }
                        <span class="viu-dept-card__code">Mã khoa @d.Code</span>
                        <span class="viu-dept-card__name">@d.Name</span>
                        @if (!string.IsNullOrWhiteSpace(d.Description))
                        {
                            <span class="viu-dept-card__desc">@d.Description</span>
                        }
                        <span class="viu-dept-card__foot">
                            @d.Majors.Count ngành đào tạo · @d.Lecturers.Count giảng viên
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <strong>Chưa có dữ liệu khoa</strong>
                Thông tin khoa sẽ được cập nhật sau.
            </div>
        }
    </div>
</section>

<!-- ===== Danh sách ngành ===== -->
<section class="section section--alt">
    <div class="wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <div class="sec-head sec-head--plain">
                    <span class="eyebrow">Chương trình</span>
                    <h2 class="sec-head__title">Ngành đào tạo</h2>
                </div>
                <p class="mb-0 text-muted" style="font-size:.9rem;">
                    @if (string.IsNullOrWhiteSpace(filter) && string.IsNullOrWhiteSpace(keyword))
                    {
                        <span>
                            @Model.Majors.Count ngành đào tạo, trong đó
                            @VIUUniversity.Data.MajorCatalogK50.All.Length ngành đại học
                            chính quy khóa 50.
                        </span>
                    }
                    else if (string.IsNullOrWhiteSpace(filter))
                    {
                        <span>Tìm thấy @majors.Count ngành khớp với “@keyword”.</span>
                    }
                    else
                    {
                        var dept = Model.Departments.FirstOrDefault(d => d.Id.ToString() == filter);
                        <span>Ngành thuộc @dept?.Name (@majors.Count ngành).</span>
                    }
                </p>
            </div>

            @if (Model.Departments.Any())
            {
                <form method="get" asp-controller="Academics" asp-action="Index" class="d-flex gap-2 flex-wrap">
                    <label class="visually-hidden" for="kw-nganh">Tìm theo tên hoặc mã ngành</label>
                    <input class="form-control" id="kw-nganh" type="search" name="keyword"
                           value="@keyword" placeholder="Tìm theo tên hoặc mã ngành..."
                           style="width:min(320px, 100%);" />
                    <label class="visually-hidden" for="khoa">Lọc theo khoa</label>
                    <select class="form-select" id="khoa" name="khoa" style="width:auto;">
                        <option value="">Tất cả các khoa</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id" selected="@(d.Id.ToString() == filter)">@d.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn-viu btn-viu-outline">Lọc</button>
                    @if (!string.IsNullOrWhiteSpace(filter) || !string.IsNullOrWhiteSpace(keyword))
                    {
                        <a class="btn-viu btn-viu-ghost" href="/dao-tao">Xoá</a>
                    }
                </form>
            }
        </div>

        @if (majors.Any())
        {
            @* Lưới thẻ thay cho bảng: mỗi ngành có ảnh đại diện riêng, bảng cột
               không chỗ đặt ảnh nên 21 ảnh đó chỉ hiện ở trang chi tiết. Dùng lại
               đúng thành phần .tile của Tin tức nên không lệch thiết kế. *@
            <div class="row g-4">
                @foreach (var m in majors)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="tile">
                            @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                            {
                                <div class="tile__media">
                                    @Html.Img(m.ImageUrl, "Hình ảnh ngành " + m.Name,
                                        sizes: "(max-width: 767px) 100vw, (max-width: 991px) 50vw, 33vw")
                                </div>
                            }
                            <div class="tile__body">
                                <div class="tile__meta" style="padding-top:0;">
                                    <span class="badge-viu">Mã @m.Code</span>
                                    @if (m.Department != null)
                                    {
                                        <a class="ms-2" href="/dao-tao/khoa/@m.Department.Slug">@m.Department.Name</a>
                                    }
                                </div>
                                <h3 class="tile__title">
                                    <a class="tile__link" href="/dao-tao/nganh/@m.Slug">@m.Name</a>
                                </h3>
                                @if (Html.HasText(m.Description))
                                {
                                    <p class="tile__excerpt">@Html.Excerpt(m.Description)</p>
                                }
                                <div class="tile__meta">
                                    @if (m.DurationYears > 0)
                                    {
                                        <span>@m.DurationYears năm</span>
                                        <span aria-hidden="true">·</span>
                                    }
                                    @* Học phí không ghi cạnh ngành: mức đổi theo từng
                                       năm nên chỉ dẫn tới trang văn bản gốc. *@
                                    <a href="/hoc-phi">Học phí theo văn bản</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <strong>Không có ngành đào tạo phù hợp</strong>
                Hãy xoá bộ lọc hoặc thử khoa khác.
            </div>
        }

        @* Ngành có trong cơ sở dữ liệu nhưng không thuộc danh mục 21 ngành đại học
           chính quy khóa 50. Không xoá để không mất dữ liệu đã nhập, nhưng phải nói
           rõ để không ai đọc nhầm là danh sách chính thức của Trường. *@
        @{
            var ngoaiDanhMuc = Model.Majors
                .Where(m => VIUUniversity.Data.MajorCatalogK50.All.All(e => e.Code != m.Code))
                .ToList();
        }
        @if (ngoaiDanhMuc.Any())
        {
            <div class="panel mt-4">
                <div class="panel__body">
                    <strong>Ngành ngoài danh sách đại học chính quy khóa 50</strong>
                    <p class="small text-muted mb-2">
                        Danh sách 21 ngành đại học chính quy khóa 50 được trích từ cổng
                        tuyển sinh chính thức của Trường. Các ngành dưới đây có trong
                        cơ sở dữ liệu nhưng không có trong danh sách đó, nên mã ngành và
                        nội dung chưa được kiểm chứng:
                    </p>
                    <ul class="small mb-0">
                        @foreach (var m in ngoaiDanhMuc)
                        {
                            <li>
                                <a href="/dao-tao/nganh/@m.Slug">@m.Name</a>
                                <span class="text-muted">(mã @m.Code)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</section>