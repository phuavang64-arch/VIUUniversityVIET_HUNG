@model List<VIUUniversity.Models.Lecturer>
@{
    ViewData["Title"] = "Đội ngũ giảng viên";
    ViewData["Description"] = "Đội ngũ giảng viên của Trường Đại học Công nghiệp Việt - Hung.";
    var departments = ViewBag.Departments as List<VIUUniversity.Models.Department> ?? new();
    int? selected = ViewBag.SelectedDepartmentId as int?;
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-students-campus.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/dao-tao">Đào tạo</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giảng viên</li>
            </ol>
        </nav>
        <h1>Đội ngũ giảng viên</h1>
        <p>Giảng viên đang công tác tại các khoa của nhà trường.</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <p class="mb-0 text-muted">
                @if (Model.Any())
                {
                    <span>Danh sách @Model.Count giảng viên.</span>
                }
            </p>

            @if (departments.Any())
            {
                <form method="get" asp-controller="Academics" asp-action="Lecturers" class="d-flex gap-2">
                    <label class="visually-hidden" for="dept">Lọc theo khoa</label>
                    <select class="form-select" id="dept" name="departmentId" style="width:auto;">
                        <option value="">Tất cả các khoa</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Id" selected="@(d.Id == selected)">@d.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn-viu btn-viu-outline">Lọc</button>
                    @if (selected.HasValue)
                    {
                        <a class="btn-viu btn-viu-ghost" href="/dao-tao/giang-vien">Xoá</a>
                    }
                </form>
            }
        </div>

        @if (Model.Any())
        {
            <div class="panel">
                <ul class="list-unstyled mb-0">
                    @foreach (var l in Model)
                    {
                        <li class="p-3" style="border-bottom:1px solid var(--line-soft);">
                            <div class="row g-3 align-items-start">
                                <div class="col-md-4">
                                    <div style="font-weight:600;font-size:.98rem;">@l.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(l.AcademicTitle))
                                    {
                                        <div class="small text-muted">@l.AcademicTitle</div>
                                    }
                                </div>
                                <div class="col-md-8">
                                    @if (!string.IsNullOrWhiteSpace(l.Biography))
                                    {
                                        <p class="small mb-2">@l.Biography</p>
                                    }
                                    <div class="small text-muted">
                                        @if (l.Department != null)
                                        {
                                            <a href="/dao-tao/khoa/@l.Department.Slug">@l.Department.Name</a>
                                            <span class="text-faint" style="margin:0 .4rem;">·</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(l.Email))
                                        {
                                            <a href="mailto:@l.Email">@l.Email</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(l.Phone))
                                        {
                                            <span class="text-faint" style="margin:0 .4rem;">·</span>
                                            <span>@l.Phone</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="empty-state">
                <strong>Chưa có dữ liệu giảng viên</strong>
                Danh sách sẽ được cập nhật sau.
            </div>
        }
    </div>
</section>