@model VIUUniversity.Models.Announcement
@{
    ViewData["Title"] = Model.Title;
}

<div class="viu-pagehead">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/thong-bao">Thông báo</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p>
            @if (Model.Category != null)
            {
                <span>@Model.Category.Name · </span>
            }
            <span>@Model.PublishedAt?.ToString("dd/MM/yyyy")</span>
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap wrap-narrow">
        <div class="viu-prose">
            @* Nội dung đã được sanitize ở tầng service trước khi lưu. *@
            @Html.Raw(Model.Content)
        </div>

        <div class="mt-5 pt-4" style="border-top:1px solid var(--line);">
            <a class="btn-viu btn-viu-ghost" href="/thong-bao">Về danh sách thông báo</a>
        </div>
    </div>
</section>