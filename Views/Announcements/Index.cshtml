@model VIUUniversity.ViewModels.PagedResult<VIUUniversity.Models.Announcement>
@{
    ViewData["Title"] = "Thông báo";
    ViewData["Description"] = "Thông báo chính thức của Trường Đại học Công nghiệp Việt - Hung.";
    int totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-plaza.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thông báo</li>
            </ol>
        </nav>
        <h1>Thông báo</h1>
        <p>@Model.TotalCount thông báo</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        @if (Model.Items.Any())
        {
            <div class="panel">
                <ul class="list-unstyled mb-0">
                    @foreach (var a in Model.Items)
                    {
                        <li style="border-bottom:1px solid var(--line-soft);">
                            <a href="/thong-bao/@a.Id" class="d-block p-3"
                               style="color:var(--ink-body);text-decoration:none;">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                    @if (a.IsImportant)
                                    {
                                        <span class="badge-viu badge-viu--navy">Quan trọng</span>
                                    }
                                    @if (a.Category != null)
                                    {
                                        <span class="badge-viu">@a.Category.Name</span>
                                    }
                                    <span class="small text-faint">@a.PublishedAt?.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div style="font-weight:600;font-size:.98rem;">@a.Title</div>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4" aria-label="Phân trang">
                    <ul class="pagination">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(Model.PageNumber <= 1 ? "#" : $"/thong-bao?page={Model.PageNumber - 1}")">Trước</a>
                        </li>
                        @for (var i = 1; i <= totalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="/thong-bao?page=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(Model.PageNumber >= totalPages ? "#" : $"/thong-bao?page={Model.PageNumber + 1}")">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="empty-state">
                <strong>Chưa có thông báo</strong>
                Trang hiện chưa có thông báo nào.
            </div>
        }
    </div>
</section>