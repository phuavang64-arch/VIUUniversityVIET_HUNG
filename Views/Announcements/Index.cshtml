@model PagedResult<Announcement>
@{
    ViewData["Title"] = "Bảng Thông báo Chính thức - Đại học Công nghiệp Việt - Hung";
}

<!-- Header -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, var(--viu-navy-dark) 0%, var(--viu-navy) 60%, #173f6b 100%); border-bottom: 4px solid var(--viu-gold);">
    <div class="container py-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Thông báo</li>
            </ol>
        </nav>
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 text-uppercase mb-2">Văn bản & Thông báo nội bộ</span>
        <h1 class="display-5 fw-bold mb-3">Bảng Thông báo Điện tử</h1>
        <p class="lead text-white-75 mb-0" style="max-width: 750px;">
            Kênh thông tin chính thức về kế hoạch đào tạo, lịch thi, học phí, tuyển dụng và các thông báo khẩn cấp từ Ban Giám hiệu.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white border-top border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-bell text-warning me-2"></i>Danh sách thông báo</h4>
                    <span class="badge bg-light text-dark border">@Model.TotalCount văn bản</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var a in Model.Items)
                    {
                        <div class="viu-announce-item p-3 rounded-3 bg-light border">
                            <div class="viu-announce-date">
                                <div class="day">@a.PublishedAt?.ToString("dd")</div>
                                <div class="month">Tháng @a.PublishedAt?.ToString("MM")</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                                    <span class="badge bg-secondary" style="font-size: 11px;">@(a.Category?.Name ?? "Thông báo")</span>
                                    @if (a.IsImportant)
                                    {
                                        <span class="badge badge-important"><i class="fa-solid fa-triangle-exclamation me-1"></i>QUAN TRỌNG</span>
                                    }
                                    @if (a.PublishedAt >= DateTime.UtcNow.AddDays(-3))
                                    {
                                        <span class="badge bg-warning text-dark fw-bold" style="font-size: 11px;">MỚI</span>
                                    }
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@a.Id" class="text-decoration-none text-dark hover-primary">
                                        @a.Title
                                    </a>
                                </h5>
                                <div class="small text-muted">
                                    <i class="fa-regular fa-calendar-check me-1"></i>Đăng ngày @a.PublishedAt?.ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(a.AttachmentUrl))
                                    {
                                        <span class="ms-3 text-primary"><i class="fa-solid fa-paperclip me-1"></i>Có tệp đính kèm</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!Model.Items.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-regular fa-bell-slash fa-3x mb-3"></i>
                            <h5>Hiện chưa có thông báo nào được đăng tải.</h5>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4 pt-3 border-top">
                        <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" href="?page=@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>
