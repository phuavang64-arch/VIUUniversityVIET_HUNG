@model VIUUniversity.ViewModels.PagedResult<VIUUniversity.Models.Event>
@{
    ViewData["Title"] = "Sự kiện";
    ViewData["Description"] = "Sự kiện, hoạt động của Trường Đại học Công nghiệp Việt - Hung.";
    int totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    // Khớp số cột với số sự kiện thực có — xem giải thích ở Views/News/Index.cshtml.
    var itemCols = Model.Items.Count switch
    {
        <= 1 => "col-12",
        2 => "col-md-6",
        _ => "col-md-6 col-lg-4",
    };
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-stage.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sự kiện</li>
            </ol>
        </nav>
        <h1>Sự kiện</h1>
        <p>@Model.TotalCount sự kiện</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        @if (Model.Items.Any())
        {
            <div class="row g-4">
                @foreach (var e in Model.Items)
                {
                    <div class="@itemCols">
                        <article class="tile">
                            @if (!string.IsNullOrWhiteSpace(e.ImageUrl))
                            {
                                <div class="tile__media">
                                    @Html.Img(e.ImageUrl, "", sizes: "(max-width: 767px) 100vw, 50vw")
                                </div>
                            }
                            <div class="tile__body">
                                <div class="small text-muted mb-1">@e.StartAt.ToString("dd/MM/yyyy")</div>
                                <h3 class="tile__title"><a class="tile__link" href="/su-kien/@e.Slug">@e.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <p class="tile__excerpt">@e.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(e.Location))
                                {
                                    <div class="tile__meta">@e.Location</div>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4" aria-label="Phân trang">
                    <ul class="pagination">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@(Model.PageNumber <= 1 ? "#" : $"/su-kien?page={Model.PageNumber - 1}")">Trước</a>
                        </li>
                        @for (var i = 1; i <= totalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="/su-kien?page=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@(Model.PageNumber >= totalPages ? "#" : $"/su-kien?page={Model.PageNumber + 1}")">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="empty-state">
                <strong>Chưa có sự kiện</strong>
                Trang hiện chưa có sự kiện nào.
            </div>
        }
    </div>
</section>