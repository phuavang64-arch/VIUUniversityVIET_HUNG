@model VIUUniversity.Models.Event
@{
    ViewData["Title"] = Model.Title;
}

<div class="viu-pagehead">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/su-kien">Sự kiện</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        <p>
            <span>@Model.StartAt.ToString("dd/MM/yyyy")</span>
            @if (Model.EndAt.HasValue)
            {
                <span> – @Model.EndAt.Value.ToString("dd/MM/yyyy")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <span> · @Model.Location</span>
            }
        </p>
    </div>
</div>

<section class="section">
    <div class="wrap wrap-narrow">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <figure style="margin:0 0 1.75rem;">
                @Html.Img(Model.ImageUrl, "",
                    style: "width:100%;border-radius:var(--r);border:1px solid var(--line);",
                    sizes: "(max-width: 991px) 100vw, 75vw")
            </figure>
        }

        <div class="viu-prose">
            @* Mô tả đã được sanitize ở tầng service trước khi lưu. *@
            @Html.Raw(Model.Description)
        </div>

        <div class="mt-5 pt-4" style="border-top:1px solid var(--line);">
            <a class="btn-viu btn-viu-ghost" href="/su-kien">Về danh sách sự kiện</a>
        </div>
    </div>
</section>