@model News
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
}

<section class="viu-section-alt py-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Tin tức</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>
    </div>
</section>

<section class="viu-section">
    <div class="container" style="max-width:860px;">
        <span class="badge-cat mb-3 d-inline-block">@Model.Category?.Name</span>
        <h1 class="fw-bold mb-3" style="color:var(--viu-navy)">@Model.Title</h1>
        <p class="text-muted mb-4">
            <i class="fa-regular fa-calendar me-1"></i>@Model.PublishedAt?.ToString("dd/MM/yyyy")
            &middot; <i class="fa-regular fa-eye me-1"></i>@Model.ViewCount lượt xem
            @if (Model.Author != null)
            {
                <text>&middot; <i class="fa-regular fa-user me-1"></i>@Model.Author.FullName</text>
            }
        </p>
        @if (!string.IsNullOrEmpty(Model.Thumbnail))
        {
            <img src="@Model.Thumbnail" class="img-fluid rounded mb-4" alt="@Model.Title" />
        }
        <div class="viu-article-content fs-5" style="line-height:1.8;">
            @Html.Raw(Model.Content)
        </div>

        <div class="mt-5">
            <a asp-action="Index" class="btn btn-viu-outline" style="border-color:var(--viu-navy); color:var(--viu-navy);"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại danh sách tin tức</a>
        </div>
    </div>
</section>
