@model VIUUniversity.ViewModels.AdmissionIndexViewModel
@{
    ViewData["Title"] = "Tuyển sinh";
    ViewData["Description"] = "Thông tin tuyển sinh đại học chính quy, phương thức xét tuyển và đăng ký trực tuyến.";
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-opening.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tuyển sinh</li>
            </ol>
        </nav>
        <h1>Tuyển sinh đại học</h1>
        <p>Phương thức xét tuyển, thông tin điểm chuẩn và đăng ký tư vấn trực tuyến.</p>
    </div>
</div>

<!-- ===== Công cụ ===== -->
<section class="section--tight section--alt">
    <div class="wrap">
        <div class="viu-cols-3">
            <a class="viu-feature-card" href="/tuyen-sinh/tra-cuu-diem-chuan">
                <span class="viu-feature-card__media">
                    <img src="/images/viu/viu-hall.jpg" alt="Hội trường của nhà trường"
                         loading="lazy" />
                </span>
                <span class="viu-feature-card__body">
                    <span class="viu-feature-card__title">Tra cứu điểm chuẩn</span>
                    <span class="viu-feature-card__text">Điểm chuẩn qua các năm theo ngành</span>
                </span>
            </a>
            <a class="viu-feature-card" href="/tuyen-sinh/tinh-diem">
                <span class="viu-feature-card__media">
                    <img src="/images/viu/viu-khoa-cntt.jpg" alt="Sinh viên làm việc nhóm trên máy tính"
                         loading="lazy" />
                </span>
                <span class="viu-feature-card__body">
                    <span class="viu-feature-card__title">Công cụ tính điểm</span>
                    <span class="viu-feature-card__text">Tính điểm và gợi ý ngành phù hợp</span>
                </span>
            </a>
            <a class="viu-feature-card" href="/dao-tao">
                <span class="viu-feature-card__media">
                    <img src="/images/viu/viu-khoa-dien.jpg" alt="Sinh viên thực hành mạch điện"
                         loading="lazy" />
                </span>
                <span class="viu-feature-card__body">
                    <span class="viu-feature-card__title">Ngành đào tạo</span>
                    <span class="viu-feature-card__text">Chương trình và khung môn học</span>
                </span>
            </a>
        </div>
    </div>
</section>

<!-- ===== Phương thức xét tuyển ===== -->
<section class="section">
    <div class="wrap">
        <h2 class="section-title">Phương thức xét tuyển</h2>
        <p class="section-sub">
            Trường Đại học Công nghiệp Việt - Hung thực hiện tuyển sinh theo các phương
            thức do Bộ Giáo dục và Đào tạo phê duyệt. Dưới đây là các phương thức chính
            áp dụng cho năm tuyển sinh 2026.
        </p>
        @if (Model.Methods.Any())
        {
            <div class="row g-4 mt-3">
                @foreach (var m in Model.Methods)
                {
                    <div class="col-md-6">
                        <div class="panel h-100">
                            <div class="panel__head">
                                <h3 class="mb-0" style="font-size:1rem;color:#000000;">@m.Name</h3>
                            </div>
                            <div class="panel__body">
                                @if (!string.IsNullOrWhiteSpace(m.Description))
                                {
                                    <p class="small mb-2" style="color:#000000;">@m.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.Requirements))
                                {
                                    <p class="small mb-0" style="color:#000000;">
                                        <strong>Yêu cầu:</strong> @m.Requirements
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state mt-3">
                <strong>Chưa công bố phương thức xét tuyển</strong>
                Vui lòng liên hệ ban Tuyển sinh.
            </div>
        }

        @* Nội dung tham khảo từ cổng tuyển sinh chính thức: các phương thức phổ biến
           của Trường. Hiển thị với từ "ví dụ" để không bị đọc là thông tin chính thức
           năm 2026 — con số chính xác phải lấy từ văn bản của Ban Tuyển sinh. *@
        <div class="panel mt-4">
            <div class="panel__head">
                <h3 class="mb-0" style="font-size:.95rem;color:#000000;">Các phương thức tuyển sinh phổ biến</h3>
            </div>
            <div class="panel__body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="viu-media-split" style="align-items:center;gap:1rem;">
                            <div class="viu-media-split__media">
                                <img src="/images/viu/viu-opening.jpg" alt="Lễ khai giảng năm học tại nhà trường"
                                     loading="lazy" style="border-radius:var(--r);width:100%;aspect-ratio:16/9;object-fit:cover;" />
                            </div>
                            <div>
                                <h4 class="h6 mb-1" style="color:#000000;">Xét tuyển thẳng và ưu tiên</h4>
                                <p class="small mb-0" style="color:#000000;">
                                    Theo quy chế tuyển sinh đại học của Bộ GD&ĐT: thí sinh đạt giải
                                    trong kỳ thi học sinh giỏi quốc gia, thi năng lực được xét tuyển
                                    thẳng vào các ngành phù hợp.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="viu-media-split" style="align-items:center;gap:1rem;">
                            <div class="viu-media-split__media">
                                <img src="/images/viu/viu-khoa-cntt.jpg" alt="Sinh viên thực hành tại Khoa Công nghệ thông tin"
                                     loading="lazy" style="border-radius:var(--r);width:100%;aspect-ratio:16/9;object-fit:cover;" />
                            </div>
                            <div>
                                <h4 class="h6 mb-1" style="color:#000000;">Xét kết quả thi tốt nghiệp</h4>
                                <p class="small mb-0" style="color:#000000;">
                                    Dùng điểm thi kỳ thi tốt nghiệp THPT quốc gia kết hợp với tổ hợp
                                    môn xét tuyển để tính điểm xét tuyển theo các phương án do Trường
                                    công bố.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="viu-media-split" style="align-items:center;gap:1rem;">
                            <div class="viu-media-split__media">
                                <img src="/images/viu/viu-students-group.jpg" alt="Sinh viên nhà trường trong hoạt động học tập"
                                     loading="lazy" style="border-radius:var(--r);width:100%;aspect-ratio:16/9;object-fit:cover;" />
                            </div>
                            <div>
                                <h4 class="h6 mb-1" style="color:#000000;">Xét kết quả học tập THPT</h4>
                                <p class="small mb-0" style="color:#000000;">
                                    Xét tuyển dựa trên điểm trung bình học tập các học kỳ ở bậc THPT,
                                    theo ngưỡng điểm do Trường công bố cho từng ngành.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="viu-media-split" style="align-items:center;gap:1rem;">
                            <div class="viu-media-split__media">
                                <img src="/images/viu/viu-khoa-dien.jpg" alt="Sinh viên thực hành mạch điện"
                                     loading="lazy" style="border-radius:var(--r);width:100%;aspect-ratio:16/9;object-fit:cover;" />
                            </div>
                            <div>
                                <h4 class="h6 mb-1" style="color:#000000;">Xét đánh giá năng lực</h4>
                                <p class="small mb-0" style="color:#000000;">
                                    Một số chương trình có thể dùng kết quả kỳ thi đánh giá năng lực,
                                    đánh giá tư duy do Bộ GD&ĐT tổ chức như một trong các căn cứ xét
                                    tuyển.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="small mt-3 mb-0" style="color:#000000;">
                    <em>Lưu ý:</em> tỉ lệ và điều kiện cụ thể từng phương thức do Trường công
                    bố trong đề án tuyển sinh từng năm. Thí sinh cần xem thông báo chính thức
                    trên cổng tuyển sinh để biết chính xác phương thức được áp dụng cho ngành
                    và khóa mình đăng ký.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ===== Bảng chỉ tiêu ===== -->
<section class="section section--alt">
    <div class="wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
            <h2 class="section-title mb-0">Ngành tuyển sinh</h2>
            <a class="btn-viu btn-viu-ghost" href="/tuyen-sinh/tra-cuu-diem-chuan">Xem điểm chuẩn</a>
        </div>

        @if (Model.Majors.Any())
        {
            <div class="row g-4">
                @foreach (var m in Model.Majors)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="tile h-100">
                            @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                            {
                                <div class="tile__media">
                                    @Html.Img(m.ImageUrl, "Hình ảnh ngành " + m.MajorName,
                                        sizes: "(max-width: 767px) 100vw, (max-width: 991px) 50vw, 33vw")
                                </div>
                            }
                            <div class="tile__body">
                                <div class="tile__meta" style="padding-top:0;">
                                    <span class="badge-viu">Mã @m.MajorCode</span>
                                </div>
                                <h3 class="tile__title mt-2">
                                    @if (!string.IsNullOrWhiteSpace(m.Slug))
                                    {
                                        <a class="tile__link" href="/dao-tao/nganh/@m.Slug">@m.MajorName</a>
                                    }
                                    else
                                    {
                                        @m.MajorName
                                    }
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(m.Note))
                                {
                                    <p class="tile__excerpt">@m.Note</p>
                                }
                                <div class="tile__meta">
                                    <span>@m.SubjectCombinations</span>
                                    <span>·</span>
                                    <span>Chỉ tiêu: @(m.Quota?.ToString() ?? "—")</span>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state"><strong>Chưa có dữ liệu tuyển sinh</strong></div>
        }
    </div>
</section>

<!-- ===== Dải ảnh: cảnh tuyển sinh ===== -->
<section class="section--tight">
    <div class="wrap">
        <h2 class="section-title">Cảnh tuyển sinh</h2>
        <p class="section-sub">
            Các hoạt động tuyển sinh, tư vấn và khai giảng tại Trường qua ảnh thật.
        </p>
        <div class="viu-photo-grid viu-photo-grid--3">
            <figure>
                <picture>
                    <source type="image/webp" srcset="/images/viu/viu-opening@sm.webp 640w, /images/viu/viu-opening.webp 1600w" />
                    <img src="/images/viu/viu-opening.jpg" alt="Lễ khai giảng năm học tại nhà trường" loading="lazy" />
                </picture>
                <figcaption>Lễ khai giảng</figcaption>
            </figure>
            <figure>
                <picture>
                    <source type="image/webp" srcset="/images/viu/viu-students-cheer@sm.webp 640w, /images/viu/viu-students-cheer.webp 1600w" />
                    <img src="/images/viu/viu-students-cheer.jpg" alt="Sinh viên cổ vũ sự kiện tuyển sinh" loading="lazy" />
                </picture>
                <figcaption>Sinh viên nhà trường</figcaption>
            </figure>
            <figure>
                <picture>
                    <source type="image/webp" srcset="/images/viu/viu-students-open-day@sm.webp 640w, /images/viu/viu-students-open-day.webp 1600w" />
                    <img src="/images/viu/viu-students-open-day.jpg" alt="Sinh viên trong ngày khai giảng" loading="lazy" />
                </picture>
                <figcaption>Ngày khai giảng</figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- ===== Form đăng ký ===== -->
<section class="section" id="form-dang-ky">
    <div class="wrap wrap-narrow">
        <h2 class="section-title">Đăng ký tư vấn tuyển sinh</h2>
        <p class="section-sub">
            Ban Tuyển sinh sẽ liên hệ để hỗ trợ bạn. Các trường có dấu * là bắt buộc.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-3">@TempData["Error"]</div>
        }

        <form method="post" asp-controller="Admissions" asp-action="SubmitLead" class="panel">
            <div class="panel__body">
                <input type="hidden" asp-for="NewLead.Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="leadName">Họ và tên <span aria-hidden="true">*</span></label>
                        <input class="form-control" id="leadName" asp-for="NewLead.FullName" required />
                        <span class="form-error" asp-validation-for="NewLead.FullName"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="leadPhone">Số điện thoại <span aria-hidden="true">*</span></label>
                        <input class="form-control" id="leadPhone" asp-for="NewLead.PhoneNumber" required />
                        <span class="form-error" asp-validation-for="NewLead.PhoneNumber"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="leadEmail">Email</label>
                        <input class="form-control" id="leadEmail" type="email" asp-for="NewLead.Email" />
                        <span class="form-error" asp-validation-for="NewLead.Email"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="leadProvince">Tỉnh / thành phố</label>
                        <input class="form-control" id="leadProvince" asp-for="NewLead.Province" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="leadMajor">Ngành quan tâm</label>
                        <input class="form-control" id="leadMajor" asp-for="NewLead.DesiredMajor" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="leadMethod">Phương thức xét tuyển</label>
                        <input class="form-control" id="leadMethod" asp-for="NewLead.PreferredMethod" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="leadMsg">Nội dung</label>
                        <textarea class="form-control" id="leadMsg" rows="4" asp-for="NewLead.Message"></textarea>
                    </div>
                </div>
            </div>
            <div class="panel__body pt-0">
                <button type="submit" class="btn-viu btn-viu-primary btn-viu-block btn-viu-lg">
                    Gửi đăng ký tư vấn
                </button>
            </div>
        </form>
    </div>
</section>