@model VIUUniversity.ViewModels.ScoreSearchViewModel
@{
    ViewData["Title"] = "Tra cứu điểm chuẩn";
    ViewData["Description"] = "Tra cứu điểm chuẩn trúng tuyển các ngành đào tạo qua các năm.";
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-hall.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/tuyen-sinh">Tuyển sinh</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tra cứu điểm chuẩn</li>
            </ol>
        </nav>
        <h1>Tra cứu điểm chuẩn</h1>
        <p>Điểm chuẩn trúng tuyển các ngành đào tạo, sắp xếp theo năm bạn chọn.</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        <form method="get" asp-controller="Admissions" asp-action="Scores" class="panel mb-4">
            <div class="panel__body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="kw">Tìm ngành</label>
                        <input class="form-control" id="kw" name="keyword" value="@Model.Keyword"
                               placeholder="Tên ngành, mã ngành hoặc tổ hợp môn" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="year">Sắp xếp theo năm</label>
                        <select class="form-select" id="year" name="year">
                            <option value="2025" selected="@(Model.Year == 2025)">Năm 2025</option>
                            <option value="2024" selected="@(Model.Year == 2024)">Năm 2024</option>
                            <option value="2023" selected="@(Model.Year == 2023)">Năm 2023</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn-viu btn-viu-primary flex-fill">Tra cứu</button>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <a class="btn-viu btn-viu-ghost" href="/tuyen-sinh/tra-cuu-diem-chuan">Xoá</a>
                        }
                    </div>
                </div>
            </div>
        </form>

        @if (Model.Majors.Any())
        {
            <p class="small text-muted">@Model.Majors.Count ngành — đã sắp xếp theo điểm năm @Model.Year.</p>
            <div class="panel">
                <div class="table-scroll">
                    <table class="table-viu">
                        <thead>
                            <tr>
                                <th>Mã ngành</th>
                                <th>Ngành đào tạo</th>
                                <th>Tổ hợp môn</th>
                                <th class="num">2023</th>
                                <th class="num">2024</th>
                                <th class="num">2025</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Majors)
                            {
                                <tr>
                                    <td style="font-variant-numeric:tabular-nums;font-weight:600;">@m.MajorCode</td>
                                    <td>
                                        <strong style="color:var(--ink);">@m.MajorName</strong>
                                        @if (m.Quota.HasValue)
                                        {
                                            <div class="small text-muted">Chỉ tiêu: @m.Quota</div>
                                        }
                                    </td>
                                    <td class="text-muted">@m.SubjectCombinations</td>
                                    <td class="num">@(m.Score2023.HasValue ? m.Score2023.Value.ToString("0.00") : "—")</td>
                                    <td class="num">@(m.Score2024.HasValue ? m.Score2024.Value.ToString("0.00") : "—")</td>
                                    <td class="num">
                                        @{
                                            var isSelectedYear = Model.Year == 2025;
                                        }
                                        <strong style="color:@(isSelectedYear ? "var(--viu-blue)" : "inherit");">
                                            @(m.Score2025.HasValue ? m.Score2025.Value.ToString("0.00") : "—")
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="small text-muted mt-2">
                Điểm chuẩn mang tính tham khảo và có thể được nhà trường điều chỉnh theo từng kỳ tuyển sinh.
            </p>
        }
        else
        {
            <div class="empty-state">
                <strong>Không tìm thấy ngành phù hợp</strong>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                {
                    <span>Không có ngành nào khớp với từ khoá “@Model.Keyword”.</span>
                }
                else
                {
                    <span>Chưa có dữ liệu điểm chuẩn.</span>
                }
            </div>
        }
    </div>
</section>