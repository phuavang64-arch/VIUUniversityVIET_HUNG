@model List<VIUUniversity.Models.AdmissionMajor>
@using System.Text.Json
@{
    ViewData["Title"] = "Công cụ tính điểm";
    ViewData["Description"] = "Tính điểm xét tuyển theo tổ hợp môn và gợi ý ngành đào tạo phù hợp.";
}

<div class="viu-pagehead viu-pagehead--media"
     style="--pagehead-photo: url('/images/viu/viu-students-cheer.jpg');">
    <div class="wrap">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/tuyen-sinh">Tuyển sinh</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tính điểm</li>
            </ol>
        </nav>
        <h1>Công cụ tính điểm xét tuyển</h1>
        <p>Nhập điểm các môn thi để tính tổng điểm theo tổ hợp và so sánh với điểm chuẩn.</p>
    </div>
</div>

<section class="section">
    <div class="wrap">
        @if (Model.Any())
        {
            <form class="panel mb-4" id="scoreForm" onsubmit="return false;">
                <div class="panel__head">
                    <h2 class="admin-panel__title">Nhập điểm thi (thang 30)</h2>
                </div>
                <div class="panel__body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sMath">Toán</label>
                            <input class="form-control" id="sMath" type="number" min="0" max="10" step="0.01" value="8" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sPhys">Lý</label>
                            <input class="form-control" id="sPhys" type="number" min="0" max="10" step="0.01" value="8" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sChem">Hóa</label>
                            <input class="form-control" id="sChem" type="number" min="0" max="10" step="0.01" value="8" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sLit">Văn</label>
                            <input class="form-control" id="sLit" type="number" min="0" max="10" step="0.01" value="7" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sEng">Ngoại ngữ</label>
                            <input class="form-control" id="sEng" type="number" min="0" max="10" step="0.01" value="7" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sSinh">Sinh học</label>
                            <input class="form-control" id="sSinh" type="number" min="0" max="10" step="0.01" value="7" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sHist">Sử</label>
                            <input class="form-control" id="sHist" type="number" min="0" max="10" step="0.01" value="7" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="sGeo">Địa</label>
                            <input class="form-control" id="sGeo" type="number" min="0" max="10" step="0.01" value="7" />
                        </div>
                    </div>

                    <div class="row g-3 mt-1 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label" for="priorityArea">Khối ưu tiên (điểm cộng thêm)</label>
                            <select class="form-select" id="priorityArea">
                                <option value="0">Không cộng</option>
                                <option value="1">Khối A: +1,0 đ</option>
                                <option value="2">Khối B: +0,5 đ</option>
                                <option value="3">Khối D: +1,0 đ</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex gap-2">
                            <button type="button" class="btn-viu btn-viu-primary" id="calcBtn">Tính điểm</button>
                            <button type="reset" class="btn-viu btn-viu-ghost">Nhập lại</button>
                        </div>
                    </div>

                    <div class="mt-4" id="comboSummary" aria-live="polite"></div>
                </div>
            </form>

            <h2 class="section-title">Ngành phù hợp với điểm của bạn</h2>
            <p class="small text-muted" id="matchSummary"></p>
            <div class="row g-3" id="majorMatchList"></div>
        }
        else
        {
            <div class="empty-state">
                <strong>Chưa có dữ liệu ngành tuyển sinh</strong>
                Công cụ tính điểm cần dữ liệu điểm chuẩn để hoạt động.
            </div>
        }
    </div>
</section>

@if (Model.Any())
{
    @section Scripts {
        <script>
            // Serialise bằng System.Text.Json: nội suy chuỗi thủ công vào JS từng từng
            // có thể vỡ khi tên ngành chứa dấu nháy.
            const majorsData = @Html.Raw(JsonSerializer.Serialize(
                Model.Select(m => new
                {
                    code = m.MajorCode,
                    name = m.MajorName,
                    combinations = m.SubjectCombinations ?? "A00, A01, D01",
                    score2025 = m.Score2025 ?? 19.0,
                    quota = m.Quota ?? 0
                }),
                new JsonSerializerOptions
                {
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                }));

            const combos = {
                A00: ['sMath', 'sPhys', 'sChem'],
                A01: ['sMath', 'sPhys', 'sEng'],
                D01: ['sMath', 'sLit', 'sEng'],
                D07: ['sMath', 'sChem', 'sEng'],
                B00: ['sMath', 'sChem', 'sSinh']
            };

            const priorityMap = { 0: 0, 1: 1.0, 2: 0.5, 3: 1.0 };

            function num(id) {
                const v = parseFloat(document.getElementById(id).value);
                return isNaN(v) ? 0 : v;
            }

            function scoreCombo(key) {
                const fields = combos[key];
                if (!fields) return 0;
                return fields.reduce((sum, f) => sum + num(f), 0);
            }

            function calc() {
                const bonus = priorityMap[document.getElementById('priorityArea').value] || 0;

                const rows = Object.keys(combos).map(k => ({ key: k, score: scoreCombo(k) + bonus }));
                const best = rows.slice().sort((a, b) => b.score - a.score)[0];

                // Tổng hợp tổ hợp
                const summary = document.getElementById('comboSummary');
                summary.replaceChildren();
                const t = document.createElement('div');
                t.className = 'alert';
                t.textContent = 'Điểm cao nhất: ' + best.key + ' = ' + best.score.toFixed(2) + ' điểm'
                    + (bonus > 0 ? ' (đã cộng ' + bonus + ' điểm khối ưu tiên)' : '');
                summary.appendChild(t);

                // Đối chiếu từng ngành
                const list = document.getElementById('majorMatchList');
                list.replaceChildren();
                let matched = 0;

                majorsData.forEach(function (major) {
                    const keys = major.combinations.split(',').map(s => s.trim()).filter(k => combos[k]);
                    if (!keys.length) return;

                    let score = 0, usedKey = '';
                    keys.forEach(function (k) {
                        const s = scoreCombo(k) + bonus;
                        if (s > score) { score = s; usedKey = k; }
                    });
                    if (score === 0) { score = best.score; usedKey = best.key; }

                    const diff = +(score - major.score2025).toFixed(2);
                    let label, colour, hit;
                    if (diff >= 1) { label = 'Rất an toàn (+' + diff + ')'; colour = 'var(--viu-navy)'; hit = true; }
                    else if (diff >= 0) { label = 'Đạt chuẩn (+' + diff + ')'; colour = 'var(--viu-blue)'; hit = true; }
                    else if (diff >= -1.5) { label = 'Cơ hội xét tuyển (' + diff + ')'; colour = 'var(--ink-muted)'; hit = false; }
                    else { label = 'Thử thách (' + diff + ')'; colour = 'var(--ink-muted)'; hit = false; }
                    if (hit) matched++;

                    const col = document.createElement('div');
                    col.className = 'col-md-6 col-lg-4';

                    const card = document.createElement('div');
                    card.className = 'panel h-100 d-flex flex-column';

                    const body = document.createElement('div');
                    body.className = 'panel__body flex-fill';

                    const code = document.createElement('div');
                    code.className = 'small text-muted';
                    code.textContent = 'Mã ngành: ' + major.code;

                    const name = document.createElement('h3');
                    name.style.fontSize = '1rem';
                    name.style.margin = '.25rem 0 .5rem';
                    name.textContent = major.name;

                    const meta = document.createElement('div');
                    meta.className = 'small text-muted';
                    meta.textContent = 'Tổ hợp: ' + major.combinations
                        + (major.quota ? ' · Chỉ tiêu: ' + major.quota : '');

                    const verdict = document.createElement('div');
                    verdict.style.margin = '.6rem 0 0';
                    verdict.style.fontWeight = '600';
                    verdict.style.color = colour;
                    verdict.textContent = label;

                    body.append(code, name, meta, verdict);
                    card.appendChild(body);
                    col.appendChild(card);
                    list.appendChild(col);
                });

                document.getElementById('matchSummary').textContent =
                    'Phù hợp với ' + matched + '/' + majorsData.length + ' ngành.';
            }

            document.getElementById('calcBtn').addEventListener('click', calc);
            document.getElementById('priorityArea').addEventListener('change', calc);
            document.querySelectorAll('#scoreForm input[type=number]').forEach(function (el) {
                el.addEventListener('input', calc);
            });
            calc();
        </script>
    }
}