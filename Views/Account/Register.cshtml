@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="viu-auth-wrap">
    <div class="viu-auth-card">
        <div class="text-center mb-4">
            <div class="viu-logo-mark mx-auto mb-3">VIU</div>
            <h4 class="fw-bold" style="color:var(--viu-navy)">Tạo tài khoản</h4>
            <p class="text-muted small">Dành cho sinh viên VIU</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Họ và tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-viu-gold w-100">Đăng ký</button>
        </form>

        <p class="text-center small text-muted mt-4 mb-0">
            Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
        </p>
    </div>
</div>
