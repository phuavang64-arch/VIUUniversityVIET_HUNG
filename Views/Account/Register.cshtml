@model VIUUniversity.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["Description"] = "Tạo tài khoản trên cổng thông tin Trường Đại học Công nghiệp Việt - Hung.";
}

<section class="section">
    <div class="wrap">
        <div style="max-width:480px;margin:0 auto;">

            <div class="panel">
                <div class="panel__body">
                    <div class="text-center mb-4">
                        <img src="~/images/logo-viu.png" alt="Logo VIU" style="height:48px;" />
                        <h1 class="section-title mt-3 mb-1">Đăng ký tài khoản</h1>
                        <p class="small text-muted mb-0">Cổng thông tin điện tử VIU</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post" asp-controller="Account" asp-action="Register">
                        <div class="mb-3">
                            <label class="form-label" for="FullName">Họ và tên <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="FullName" asp-for="FullName" autocomplete="name" required />
                            <span class="form-error" asp-validation-for="FullName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Email">Email <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="Email" asp-for="Email" type="email"
                                   autocomplete="username" required />
                            <span class="form-error" asp-validation-for="Email"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Password">Mật khẩu <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="Password" asp-for="Password" type="password"
                                   autocomplete="new-password" required />
                            <span class="form-hint">
                                Tối thiểu 10 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                            </span>
                            <span class="form-error" asp-validation-for="Password"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="ConfirmPassword">Xác nhận mật khẩu <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="ConfirmPassword" asp-for="ConfirmPassword" type="password"
                                   autocomplete="new-password" required />
                            <span class="form-error" asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <button type="submit" class="btn-viu btn-viu-primary btn-viu-block btn-viu-lg">
                            Tạo tài khoản
                        </button>
                    </form>
                </div>
                <div class="panel__body text-center" style="border-top:1px solid var(--line);">
                    <span class="small text-muted">Đã có tài khoản?</span>
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                </div>
            </div>

        </div>
    </div>
</section>