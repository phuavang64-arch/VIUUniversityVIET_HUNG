@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="section">
    <div class="wrap">
        <div style="max-width:520px;margin:0 auto;">
            <div class="panel">
                <div class="panel__body text-center py-5">
                    <h1 class="section-title">Không có quyền truy cập</h1>
                    <p class="text-muted mb-4">
                        Tài khoản của bạn không được phân quyền cho khu vực này.
                        Nếu cần quyền truy cập, vui lòng liên hệ quản trị viên của nhà trường.
                    </p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a class="btn-viu btn-viu-primary" href="/">Về trang chủ</a>
                        <a class="btn-viu btn-viu-ghost" asp-controller="Account" asp-action="Login">Đăng nhập tài khoản khác</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>