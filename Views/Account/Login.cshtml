@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<div class="viu-auth-wrap">
    <div class="viu-auth-card">
        <div class="text-center mb-4">
            <div class="viu-logo-mark mx-auto mb-3">VIU</div>
            <h4 class="fw-bold" style="color:var(--viu-navy)">Đăng nhập hệ thống</h4>
            <p class="text-muted small">Cổng thông tin điện tử VIU</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input asp-for="Email" class="form-control" placeholder="ban@viu.edu.vn" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small"></label>
            </div>
            <button type="submit" class="btn btn-viu-gold w-100">Đăng nhập</button>
        </form>

        <p class="text-center small text-muted mt-4 mb-0">
            Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
        </p>
    </div>
</div>
