@model VIUUniversity.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập hệ thống cổng thông tin Trường Đại học Công nghiệp Việt - Hung.";
}

<section class="section">
    <div class="wrap">
        <div style="max-width:420px;margin:0 auto;">

            <div class="panel">
                <div class="panel__body">
                    <div class="text-center mb-4">
                        <img src="~/images/logo-viu.png" alt="Logo VIU" style="height:48px;" />
                        <h1 class="section-title mt-3 mb-1">Đăng nhập</h1>
                        <p class="small text-muted mb-0">Cổng thông tin điện tử VIU</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post" asp-controller="Account" asp-action="Login"
                          asp-route-returnUrl="@ViewBag.ReturnUrl">
                        <div class="mb-3">
                            <label class="form-label" for="Email">Email <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="Email" asp-for="Email" type="email"
                                   autocomplete="username" required autofocus />
                            <span class="form-error" asp-validation-for="Email"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Password">Mật khẩu <span aria-hidden="true">*</span></label>
                            <input class="form-control" id="Password" asp-for="Password" type="password"
                                   autocomplete="current-password" required />
                            <span class="form-error" asp-validation-for="Password"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="RememberMe" id="RememberMe" />
                            <label class="form-check-label small" for="RememberMe">Ghi nhớ đăng nhập</label>
                        </div>

                        <button type="submit" class="btn-viu btn-viu-primary btn-viu-block btn-viu-lg">
                            Đăng nhập
                        </button>
                    </form>
                </div>
                <div class="panel__body text-center" style="border-top:1px solid var(--line);">
                    <span class="small text-muted">Chưa có tài khoản?</span>
                    <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
                </div>
            </div>

        </div>
    </div>
</section>