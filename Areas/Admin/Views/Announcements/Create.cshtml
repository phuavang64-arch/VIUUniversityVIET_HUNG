@model Announcement
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm thông báo";
}

<div class="admin-panel" style="max-width:800px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề</label>
            <input asp-for="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Chuyên mục</label>
            <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                <option value="">-- Chọn chuyên mục --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Nội dung</label>
            <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">File đính kèm (URL PDF)</label>
            <input asp-for="AttachmentUrl" class="form-control" placeholder="/uploads/documents/thong-bao.pdf" />
        </div>
        <div class="form-check mb-2">
            <input asp-for="IsImportant" class="form-check-input" />
            <label asp-for="IsImportant" class="form-check-label">Đánh dấu quan trọng</label>
        </div>
        <div class="form-check mb-4">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">Đăng ngay</label>
        </div>
        <button type="submit" class="btn btn-viu-primary"><i class="fa-solid fa-check me-2"></i>Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
