@model News
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Chỉnh sửa tin tức";
}

<div class="admin-card" style="max-width:800px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="AuthorId" />
        <input type="hidden" asp-for="ViewCount" />
        <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề</label>
            <input asp-for="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Đường dẫn (slug)</label>
            <input asp-for="Slug" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Chuyên mục</label>
            <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name", Model.CategoryId))"></select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Tóm tắt</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Ảnh đại diện (URL)</label>
            <input asp-for="Thumbnail" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Nội dung</label>
            <textarea asp-for="Content" class="form-control" rows="10" required></textarea>
        </div>
        <div class="form-check mb-4">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">Đã đăng</label>
        </div>

        <button type="submit" class="btn btn-viu-gold"><i class="fa-solid fa-check me-2"></i>Cập nhật</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
