@model PagedResult<News>
@{
    ViewData["Title"] = "Quản lý tin tức";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control form-control-sm" placeholder="Tìm theo tiêu đề..." style="width:260px" />
            <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        <a asp-action="Create" class="btn btn-viu-gold btn-sm"><i class="fa-solid fa-plus me-2"></i>Thêm tin tức</a>
    </div>

    <div class="table-responsive">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Chuyên mục</th>
                    <th>Lượt xem</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold" style="max-width:320px;">@n.Title</td>
                        <td>@n.Category?.Name</td>
                        <td>@n.ViewCount</td>
                        <td>@n.PublishedAt?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <form asp-action="TogglePublish" asp-route-id="@n.Id" method="post" class="d-inline">
                                <input type="hidden" name="isPublished" value="@(!n.IsPublished)" />
                                <button type="submit" class="btn btn-sm @(n.IsPublished ? "btn-success" : "btn-secondary")">
                                    @(n.IsPublished ? "Đã đăng" : "Nháp")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa tin tức này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có tin tức nào.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm justify-content-center mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?page=@i&keyword=@ViewBag.Keyword">@i</a></li>
                }
            </ul>
        </nav>
    }
</div>
