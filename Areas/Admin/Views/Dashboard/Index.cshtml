@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<!-- Thẻ số liệu: giảm số lượng, chỉ giữ những gì nhân viên cần hằng ngày -->
<div class="admin-stat-row">
    <div class="admin-stat">
        <div class="admin-stat__label">Thí sinh chờ xử lý</div>
        <div class="admin-stat__value">@Model.TotalPendingLeads</div>
        <div class="admin-stat__hint admin-stat__hint--alert">
            <a href="/admin/thi-sinh?processed=false">Xem danh sách</a>
        </div>
    </div>
    <div class="admin-stat">
        <div class="admin-stat__label">Tin nhắn chưa đọc</div>
        <div class="admin-stat__value">@Model.TotalUnreadMessages</div>
        <div class="admin-stat__hint">
            <a href="/admin/lien-he?isRead=false">Xem danh sách</a>
        </div>
    </div>
    <div class="admin-stat">
        <div class="admin-stat__label">Tin tức</div>
        <div class="admin-stat__value">@Model.TotalNews</div>
        <div class="admin-stat__hint">
            <a href="/Admin/News">Quản lý tin tức</a>
        </div>
    </div>
    <div class="admin-stat">
        <div class="admin-stat__label">Ngành đào tạo</div>
        <div class="admin-stat__value">@Model.TotalMajors</div>
        <div class="admin-stat__hint">@Model.TotalDepartments khoa · @Model.TotalLecturers giảng viên</div>
    </div>
</div>

<!-- Biểu đồ: một tông xanh duy nhất, vẽ bằng SVG không phụ thuộc thư viện -->
<div class="admin-panel">
    <div class="admin-panel__head">
        <h2 class="admin-panel__title">Tin tức theo tháng</h2>
        <div class="admin-legend">
            <span><span class="admin-legend__swatch"></span>Số bài đăng</span>
        </div>
    </div>
    <div class="admin-panel__body">
        @if (Model.NewsByMonth.Any())
        {
            var max = Model.NewsByMonth.Max(x => x.Count);
            var w = 760.0;
            var barW = Math.Max(18.0, w / Model.NewsByMonth.Count - 16);
            var h = 180.0;
            <svg viewBox="0 0 @(w) @(h + 26)" class="admin-chart" role="img"
                 aria-label="Biểu đồ cột số bài tin tức theo tháng">
                <line x1="0" y1="@(h)" x2="@(w)" y2="@(h)" class="admin-chart__axis" />
                @for (var i = 0; i < Model.NewsByMonth.Count; i++)
                {
                    var item = Model.NewsByMonth[i];
                    var barH = max > 0 ? Math.Round(item.Count / (double)max * (h - 26)) : 0;
                    var x = 10 + i * (w / Model.NewsByMonth.Count);
                    var y = h - barH;
                    <rect x="@(x)" y="@(y)" width="@(barW)" height="@(Math.Max(barH, 1))" class="admin-chart__bar">
                        <title>@item.Label: @item.Count bài</title>
                    </rect>
                    @* <text> xung đột với tag <text> của Razor -> phát qua Html.Raw *@
                    @Html.Raw($"<text x='{x + barW / 2}' y='{h + 16}' text-anchor='middle' class='admin-chart__label'>{System.Net.WebUtility.HtmlEncode(item.Label)}</text>")
                    @Html.Raw($"<text x='{x + barW / 2}' y='{y - 6}' text-anchor='middle' class='admin-chart__label'>{item.Count}</text>")
                }
            </svg>
        }
        else
        {
            <div class="empty-state"><strong>Chưa có dữ liệu</strong>Chưa có tin tức nào được đăng.</div>
        }
    </div>
</div>

<div class="admin-panel">
    <div class="admin-panel__head">
        <h2 class="admin-panel__title">Lượt đăng ký tuyển sinh theo tháng</h2>
    </div>
    <div class="admin-panel__body">
        @if (Model.LeadsByMonth.Any())
        {
            <table class="table-viu">
                <thead>
                    <tr><th>Tháng</th><th class="num">Số hồ sơ</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.LeadsByMonth)
                    {
                        <tr>
                            <td>@l.Label</td>
                            <td class="num">@l.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><strong>Chưa có dữ liệu</strong></div>
        }
    </div>
</div>