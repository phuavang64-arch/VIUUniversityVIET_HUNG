@model List<VIUUniversity.Models.GalleryImage>
@{
    ViewData["Title"] = "Thư viện ảnh trường";
    var albums = ViewBag.Albums as List<string> ?? new();
    string? selectedAlbum = ViewBag.SelectedAlbum;
}

<div class="admin-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div class="d-flex gap-2 flex-wrap">
            <a href="?album=" class="btn btn-sm @(selectedAlbum == null ? "btn-viu-primary" : "btn-outline-secondary")">Tất cả</a>
            @foreach (var album in albums)
            {
                <a href="?album=@album" class="btn btn-sm @(selectedAlbum == album ? "btn-viu-primary" : "btn-outline-secondary")">@album</a>
            }
        </div>
        <a asp-action="Create" class="btn btn-viu-primary btn-sm">
            <i class="fa-solid fa-plus me-2"></i>Thêm ảnh
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-images fa-3x mb-3 opacity-20"></i>
            <p>Chưa có ảnh nào. <a asp-action="Create">Thêm ảnh đầu tiên</a></p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var img in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                        <div style="position:relative; padding-top:66.67%; overflow:hidden; background:#f0f4f8;">
                            <img src="@img.ImageUrl" alt="@img.Caption"
                                 style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;"
                                 loading="lazy"
                                 onerror="this.src='/images/news-placeholder.jpg'" />
                        </div>
                        <div class="card-body p-2">
                            <div class="small fw-semibold text-truncate" title="@img.Caption">@(img.Caption ?? "—")</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                @if (!string.IsNullOrEmpty(img.Album))
                                {
                                    <span class="badge rounded-pill" style="background:var(--viu-blue-soft);color:var(--viu-blue-dark);font-size:0.72rem;">@img.Album</span>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@img.Id" class="btn btn-sm btn-outline-primary py-0 px-1" style="font-size:0.75rem;">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@img.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa ảnh này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size:0.75rem;">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
