@model VIUUniversity.Models.GalleryImage
@{
    ViewData["Title"] = "Chỉnh sửa ảnh";
}

<div class="admin-panel" style="max-width:700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0" style="color:var(--viu-blue);">
            <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa ảnh
        </h5>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Thư viện
        </a>
    </div>

    <div class="mb-3 text-center">
        <img src="@Model.ImageUrl" alt="@Model.Caption"
             style="max-height:240px;max-width:100%;border-radius:12px;border:2px solid var(--viu-border);"
             onerror="this.src='/images/news-placeholder.jpg'" />
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Thay ảnh mới (để trống giữ nguyên)</label>
            <input type="file" name="imageFile" accept="image/*" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Hoặc cập nhật URL ảnh</label>
            <input asp-for="ImageUrl" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Chú thích ảnh</label>
            <input asp-for="Caption" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Album</label>
            <input asp-for="Album" class="form-control" list="albumList2" />
            <datalist id="albumList2">
                <option value="campus" />
                <option value="events" />
                <option value="students" />
                <option value="facilities" />
                <option value="ceremonies" />
                <option value="sports" />
            </datalist>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Thứ tự hiển thị</label>
            <input asp-for="DisplayOrder" type="number" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-viu-primary flex-grow-1">
                <i class="fa-solid fa-floppy-disk me-2"></i>Lưu thay đổi
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>
