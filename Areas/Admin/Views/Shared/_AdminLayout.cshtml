@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string c) => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Quản trị") - Quản trị VIU</title>
    <link rel="icon" type="image/png" href="~/images/logo-viu.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<div class="admin-shell">

    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-sidebar__brand">
            <img src="~/images/logo-viu.png" alt="Logo VIU" />
            <div>
                <div class="admin-sidebar__brand-name">Quản trị hệ thống</div>
                <div class="admin-sidebar__brand-sub">Trường ĐH CN Việt - Hung</div>
            </div>
        </div>

        <nav class="admin-nav" aria-label="Điều hướng quản trị">
            <div class="admin-nav__group">Tổng quan</div>
            <a class="admin-nav__link @(IsActive("Dashboard") ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i> Tổng quan
            </a>

            <div class="admin-nav__group">Nội dung</div>
            <a class="admin-nav__link @(IsActive("News") ? "active" : "")"
               asp-area="Admin" asp-controller="News" asp-action="Index">
                <i class="fa-solid fa-newspaper" aria-hidden="true"></i> Tin tức
            </a>
            <a class="admin-nav__link @(IsActive("Research") ? "active" : "")"
               asp-area="Admin" asp-controller="Research" asp-action="Index">
                <i class="fa-solid fa-flask" aria-hidden="true"></i> Nghiên cứu khoa học
            </a>
            <a class="admin-nav__link @(IsActive("Cooperations") ? "active" : "")"
               asp-area="Admin" asp-controller="Cooperations" asp-action="Index">
                <i class="fa-solid fa-handshake" aria-hidden="true"></i> Hợp tác
            </a>
            <a class="admin-nav__link @(IsActive("TuitionDocuments") ? "active" : "")"
               asp-area="Admin" asp-controller="TuitionDocuments" asp-action="Index">
                <i class="fa-solid fa-file-invoice" aria-hidden="true"></i> Văn bản học phí
            </a>
            <a class="admin-nav__link @(IsActive("Announcements") ? "active" : "")"
               asp-area="Admin" asp-controller="Announcements" asp-action="Index">
                <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Thông báo
            </a>
            <a class="admin-nav__link @(IsActive("Events") ? "active" : "")"
               asp-area="Admin" asp-controller="Events" asp-action="Index">
                <i class="fa-regular fa-calendar-days" aria-hidden="true"></i> Sự kiện
            </a>
            <a class="admin-nav__link @(IsActive("Banners") ? "active" : "")"
               asp-area="Admin" asp-controller="Banners" asp-action="Index">
                <i class="fa-solid fa-image" aria-hidden="true"></i> Banner trang chủ
            </a>

            <div class="admin-nav__group">Hình ảnh</div>
            <a class="admin-nav__link @(IsActive("Gallery") ? "active" : "")"
               asp-area="Admin" asp-controller="Gallery" asp-action="Index">
                <i class="fa-solid fa-images" aria-hidden="true"></i> Thư viện ảnh
            </a>

            <div class="admin-nav__group">Tuyển sinh</div>
            <a class="admin-nav__link @(IsActive("AdmissionLeads") ? "active" : "")"
               asp-area="Admin" asp-controller="AdmissionLeads" asp-action="Index">
                <i class="fa-solid fa-user-graduate" aria-hidden="true"></i> Hồ sơ thí sinh
            </a>
            <a class="admin-nav__link @(IsActive("ContactMessages") ? "active" : "")"
               asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i> Tin nhắn liên hệ
            </a>

            <div class="admin-nav__group">Hệ thống</div>
            <a class="admin-nav__link @(IsActive("Settings") ? "active" : "")"
               asp-area="Admin" asp-controller="Settings" asp-action="Index">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i> Cài đặt website
            </a>
        </nav>

        <div class="admin-nav__foot">
            <a class="btn-viu btn-viu-invert btn-viu-sm btn-viu-block" href="/" target="_blank" rel="noopener">
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Xem website
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                <button type="submit" class="btn-viu btn-viu-ghost btn-viu-sm btn-viu-block">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="admin-burger" id="adminBurger" type="button" aria-label="Mở menu" aria-expanded="false">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <h1 class="admin-topbar__title">@(ViewData["Title"] ?? "Tổng quan")</h1>
            </div>
            <div class="admin-topbar__actions">
                <span class="admin-topbar__meta">@DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success mb-3">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        var burger = document.getElementById('adminBurger');
        var sidebar = document.getElementById('adminSidebar');
        var scrim = null;

        function close() {
            sidebar.classList.remove('is-open');
            burger.setAttribute('aria-expanded', 'false');
            if (scrim) { scrim.remove(); scrim = null; }
        }

        burger.addEventListener('click', function () {
            var open = sidebar.classList.toggle('is-open');
            burger.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) {
                scrim = document.createElement('div');
                scrim.className = 'admin-scrim';
                scrim.addEventListener('click', close);
                document.body.appendChild(scrim);
            }
        });

        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        window.addEventListener('resize', function () { if (window.innerWidth > 900) close(); });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>