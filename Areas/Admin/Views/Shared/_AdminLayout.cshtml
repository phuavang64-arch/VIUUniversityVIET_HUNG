<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Quản trị") - VIU Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="admin-sidebar">
        <div class="brand">
            <div class="viu-logo-mark viu-logo-mark--light">VIU</div>
            <div>
                <div>VIU Admin</div>
                <div class="small fw-normal opacity-75" style="font-size:.72rem">Cổng quản trị</div>
            </div>
        </div>
        <nav class="nav flex-column mt-3">
            <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge me-2"></i>Tổng quan</a>
            <a class="nav-link" asp-area="Admin" asp-controller="News" asp-action="Index"><i class="fa-solid fa-newspaper me-2"></i>Tin tức</a>
            <a class="nav-link" asp-area="Admin" asp-controller="Announcements" asp-action="Index"><i class="fa-solid fa-bullhorn me-2"></i>Thông báo</a>
            <a class="nav-link" asp-area="Admin" asp-controller="Events" asp-action="Index"><i class="fa-regular fa-calendar-days me-2"></i>Sự kiện</a>
            <a class="nav-link" asp-area="Admin" asp-controller="Banners" asp-action="Index"><i class="fa-solid fa-images me-2"></i>Banner trang chủ</a>
            <hr class="text-white-50 mx-3" />
            <a class="nav-link" href="/" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square me-2"></i>Xem website</a>
            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="px-3 mt-2">
                <button type="submit" class="btn btn-outline-light btn-sm w-100"><i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất</button>
            </form>
        </nav>
    </aside>

    <div class="admin-content">
        <div class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button id="adminSidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none"><i class="fa-solid fa-bars"></i></button>
                <h5 class="mb-0 fw-bold" style="color:var(--viu-navy)">@ViewData["Title"]</h5>
            </div>
            <div class="small text-muted">
                <i class="fa-regular fa-user me-1"></i>@User.Identity!.Name
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
