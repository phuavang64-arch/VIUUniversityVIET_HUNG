@model VIUUniversity.Models.ContactMessage
@{
    ViewData["Title"] = "Chi tiết liên hệ";
}

<div class="admin-panel" style="max-width:720px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1" style="color:var(--viu-blue);">
                <i class="fa-solid fa-envelope-open-text me-2"></i>@Model.Subject
            </h5>
            <p class="text-muted small mb-0">Nhận lúc @Model.CreatedAt.AddHours(7).ToString("HH:mm dd/MM/yyyy")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Danh sách thư
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="p-3 rounded-3" style="background:var(--viu-blue-soft);">
                <div class="small text-muted mb-1">Người gửi</div>
                <div class="fw-semibold">@Model.FullName</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 rounded-3" style="background:var(--viu-blue-soft);">
                <div class="small text-muted mb-1">Email</div>
                <div class="fw-semibold"><a href="mailto:@Model.Email">@Model.Email</a></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 rounded-3" style="background:var(--viu-blue-soft);">
                <div class="small text-muted mb-1">Số điện thoại</div>
                <div class="fw-semibold">
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                    }
                    else
                    {
                        <span class="text-muted">Chưa cung cấp</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 rounded-3" style="background:var(--viu-blue-soft);">
                <div class="small text-muted mb-1">Trạng thái</div>
                <div>
                    @if (Model.IsRead)
                    {
                        <span class="badge bg-secondary bg-opacity-25 text-secondary"><i class="fa-solid fa-check me-1"></i>Đã đọc</span>
                    }
                    else
                    {
                        <span class="badge bg-danger"><i class="fa-solid fa-envelope me-1"></i>Chưa đọc</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="p-4 rounded-3 border bg-light">
                <div class="small text-muted fw-bold mb-2 text-uppercase">Nội dung thư:</div>
                <div style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">@Model.Message</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4 pt-3 border-top">
        <a href="mailto:@Model.Email?subject=Phản hồi từ ĐH Công nghiệp Việt - Hung: @Model.Subject" class="btn btn-primary">
            <i class="fa-solid fa-reply me-1"></i>Trả lời qua Email
        </a>
        <form asp-action="ToggleRead" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn @(Model.IsRead ? "btn-outline-warning" : "btn-outline-success")">
                <i class="fa-solid @(Model.IsRead ? "fa-envelope" : "fa-envelope-open") me-1"></i>
                @(Model.IsRead ? "Đánh dấu chưa đọc" : "Đánh dấu đã đọc")
            </button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xóa tin nhắn này?');">
            <button type="submit" class="btn btn-outline-danger">
                <i class="fa-solid fa-trash me-1"></i>Xóa
            </button>
        </form>
    </div>
</div>
