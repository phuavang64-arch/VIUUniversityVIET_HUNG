@model List<Banner>
@{
    ViewData["Title"] = "Quản lý banner trang chủ";
}

<div class="admin-card">
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-viu-gold btn-sm"><i class="fa-solid fa-plus me-2"></i>Thêm banner</a>
    </div>
    <div class="table-responsive">
        <table class="table table-admin align-middle">
            <thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Thứ tự</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><img src="@b.ImageUrl" style="width:100px;height:56px;object-fit:cover;border-radius:6px;" /></td>
                        <td class="fw-semibold">@b.Title</td>
                        <td>@b.DisplayOrder</td>
                        <td>
                            <form asp-action="Toggle" asp-route-id="@b.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(b.IsActive ? "btn-success" : "btn-secondary")">@(b.IsActive ? "Đang hiện" : "Đã ẩn")</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa banner này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có banner nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
