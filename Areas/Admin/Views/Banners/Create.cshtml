@model Banner
@{
    ViewData["Title"] = "Thêm banner";
}

<div class="admin-panel" style="max-width:700px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger d-none-empty"></div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Tiêu đề</label>
            <input asp-for="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả ngắn</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Chọn file ảnh banner từ máy tính</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
            <div class="form-text small">Hoặc nhập đường dẫn ảnh có sẵn:</div>
            <input asp-for="ImageUrl" class="form-control mt-1" placeholder="/images/real/banner1.jpeg" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Chữ trên nút bấm</label>
                <input asp-for="ButtonText" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Đường dẫn nút bấm</label>
                <input asp-for="ButtonUrl" class="form-control" />
            </div>
        </div>
        <div class="mb-4">
            <label class="form-label fw-semibold">Thứ tự hiển thị</label>
            <input asp-for="DisplayOrder" class="form-control" type="number" />
        </div>
        <button type="submit" class="btn btn-viu-primary"><i class="fa-solid fa-check me-2"></i>Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
